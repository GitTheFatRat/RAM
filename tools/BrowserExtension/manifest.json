{
  "manifest_version": 3,
  "name": "RbxManager Local Bridge",
  "version": "1.0.2",
  "key": "",
  "description": "1-click native .ROBLOSECURITY import to RbxManager and Vietnam IP Sign-Up/DPI bridge without invalidating the captured token.",
  "permissions": [
    "cookies",
    "tabs",
    "proxy"
  ],
  "host_permissions": [
    "*://*.roblox.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.roblox.com/*"
      ],
      "js": [
        "content-signup.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Import to RbxManager",
    "default_popup": "popup.html"
  }
}
