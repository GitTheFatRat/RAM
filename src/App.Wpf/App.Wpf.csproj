<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>RbxManager.App</RootNamespace>
    <AssemblyName>RbxManager.App</AssemblyName>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RbxManager.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="Obfuscar">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="ObfuscateReleaseBuild" AfterTargets="Build" BeforeTargets="ComputeFilesToPublish;PrepareForPublish" Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != ''">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\obfuscar.xml" DestinationFolder="$(TargetDir)" />
    <Exec Command="&quot;$(Obfuscar)&quot; &quot;$(TargetDir)obfuscar.xml&quot;" WorkingDirectory="$(TargetDir)" />
    <Copy SourceFiles="$(TargetDir)Obfuscated\RbxManager.App.dll" DestinationFiles="$(TargetDir)RbxManager.App.dll" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(TargetDir)Obfuscated\RbxManager.App.dll" DestinationFiles="$(IntermediateOutputPath)RbxManager.App.dll" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(TargetDir)Obfuscated\RbxManager.Core.dll" DestinationFiles="$(TargetDir)RbxManager.Core.dll" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(TargetDir)Obfuscated\RbxManager.Core.dll" DestinationFiles="..\Core\bin\$(Configuration)\net10.0\RbxManager.Core.dll" Condition="Exists('..\Core\bin\$(Configuration)\net10.0\RbxManager.Core.dll')" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(TargetDir)Obfuscated\RbxManager.Infrastructure.dll" DestinationFiles="$(TargetDir)RbxManager.Infrastructure.dll" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(TargetDir)Obfuscated\RbxManager.Infrastructure.dll" DestinationFiles="..\Infrastructure\bin\$(Configuration)\net10.0\RbxManager.Infrastructure.dll" Condition="Exists('..\Infrastructure\bin\$(Configuration)\net10.0\RbxManager.Infrastructure.dll')" OverwriteReadOnlyFiles="true" />
    <RemoveDir Directories="$(TargetDir)Obfuscated" />
    <Delete Files="$(TargetDir)obfuscar.xml" />
  </Target>

</Project>
