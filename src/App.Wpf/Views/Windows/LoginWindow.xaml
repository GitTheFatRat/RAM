<ui:FluentWindow x:Class="RbxManager.App.Views.Windows.LoginWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:resources="clr-namespace:RbxManager.App.Resources"
                  Title="{x:Static resources:Strings.LoginWindowTitle}"
                  AutomationProperties.AutomationId="LoginWindow"
                  AutomationProperties.Name="{x:Static resources:Strings.LoginWindowTitle}"
                  Height="700"
                  Width="800"
                  MinWidth="500"
                  MinHeight="600"
                  WindowStartupLocation="CenterOwner"
                  Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{x:Static resources:Strings.LoginWindowTitle}" />

        <Grid Grid.Row="1">
            <!-- 1. Pre-Login Proxy Panel -->
            <ScrollViewer x:Name="ProxyPanel"
                          VerticalScrollBarVisibility="Auto"
                          Padding="{StaticResource PaddingLarge}"
                          Visibility="Visible">
                <StackPanel MaxWidth="500" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Static resources:Strings.LoginWindowTitle}"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="{StaticResource MarginBottomMedium}" />

                    <!-- Localized Scope Note -->
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Padding="{StaticResource PaddingMedium}"
                            Margin="{StaticResource MarginBottomMedium}">
                        <TextBlock Text="{x:Static resources:Strings.ProxyScopeNote}"
                                   TextWrapping="Wrap"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>

                    <!-- Proxy Type -->
                    <TextBlock Text="{x:Static resources:Strings.ProxyType}"
                               FontWeight="SemiBold"
                               Margin="{StaticResource MarginTight}" />
                    <ComboBox x:Name="ProxyTypeComboBox"
                              AutomationProperties.AutomationId="LoginWindow_ProxyTypeBox"
                              Margin="{StaticResource MarginBottomMedium}"
                              SelectionChanged="OnProxyTypeChanged">
                        <ComboBoxItem Content="{x:Static resources:Strings.ProxyTypeNone}" IsSelected="True" />
                        <ComboBoxItem Content="{x:Static resources:Strings.ProxyTypeHttp}" />
                        <ComboBoxItem Content="{x:Static resources:Strings.ProxyTypeSocks5}" />
                    </ComboBox>

                    <!-- Proxy Configuration Fields (Collapsed when None) -->
                    <StackPanel x:Name="ProxyFieldsPanel" Visibility="Collapsed">
                        <Grid Margin="{StaticResource MarginBottomMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static resources:Strings.ProxyHost}"
                                           FontWeight="SemiBold"
                                           Margin="{StaticResource MarginTight}" />
                                <ui:TextBox x:Name="ProxyHostBox"
                                            AutomationProperties.AutomationId="LoginWindow_ProxyHostBox"
                                            PlaceholderText="127.0.0.1 / proxy.example.com" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{x:Static resources:Strings.ProxyPort}"
                                           FontWeight="SemiBold"
                                           Margin="{StaticResource MarginTight}" />
                                <ui:TextBox x:Name="ProxyPortBox"
                                            AutomationProperties.AutomationId="LoginWindow_ProxyPortBox"
                                            Text="8080" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{x:Static resources:Strings.ProxyUsername}"
                                   FontWeight="SemiBold"
                                   Margin="{StaticResource MarginTight}" />
                        <ui:TextBox x:Name="ProxyUsernameBox"
                                    AutomationProperties.AutomationId="LoginWindow_ProxyUsernameBox"
                                    Margin="{StaticResource MarginBottomMedium}" />

                        <TextBlock Text="{x:Static resources:Strings.ProxyPassword}"
                                   FontWeight="SemiBold"
                                   Margin="{StaticResource MarginTight}" />
                        <ui:PasswordBox x:Name="ProxyPasswordBox"
                                        AutomationProperties.AutomationId="LoginWindow_ProxyPasswordBox"
                                        Margin="{StaticResource MarginBottomMedium}" />
                    </StackPanel>

                    <!-- Inline Error and Test Status -->
                    <TextBlock x:Name="InlineErrorTextBlock"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource MarginBottomMedium}"
                               Visibility="Collapsed" />

                    <TextBlock x:Name="TestStatusTextBlock"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource MarginBottomMedium}"
                               Visibility="Collapsed" />

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="{StaticResource MarginMedium}">
                        <ui:Button x:Name="TestProxyButton"
                                   AutomationProperties.AutomationId="LoginWindow_TestProxyButton"
                                   Content="{x:Static resources:Strings.TestProxy}"
                                   Margin="{StaticResource MarginTight}"
                                   Click="OnTestProxyClick"
                                   Visibility="Collapsed" />
                        <ui:Button x:Name="StartBrowserButton"
                                   AutomationProperties.AutomationId="LoginWindow_StartBrowserButton"
                                   Content="{x:Static resources:Strings.StartBrowser}"
                                   Appearance="Primary"
                                   Margin="{StaticResource MarginTight}"
                                   Click="OnStartBrowserClick" />
                        <ui:Button Content="{x:Static resources:Strings.Cancel}"
                                   AutomationProperties.AutomationId="LoginWindow_CancelButton"
                                   Margin="{StaticResource MarginTight}"
                                   Click="OnCancelClick" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 2. Browser Container (Created in code, initially hidden) -->
            <Grid x:Name="BrowserContainer" Visibility="Collapsed">
                <Grid x:Name="WebViewHost" />

                <!-- Loading Overlay -->
                <Grid x:Name="LoadingOverlay"
                      Background="{DynamicResource ApplicationBackgroundBrush}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True"
                                         HorizontalAlignment="Center"
                                         Margin="{StaticResource MarginMedium}" />
                        <TextBlock Text="{x:Static resources:Strings.LoadingRoblox}"
                                   FontSize="{StaticResource FontSizeSubtitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <ProgressBar x:Name="LoadingProgress"
                             IsIndeterminate="True"
                             VerticalAlignment="Top"
                             Height="4"
                             Visibility="Collapsed" />

                <!-- Navigation Failure Overlay with 'Change proxy' button -->
                <Grid x:Name="NavigationFailureOverlay"
                      Background="{DynamicResource ApplicationBackgroundBrush}"
                      Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="450">
                        <ui:SymbolIcon Symbol="Warning24"
                                       FontSize="48"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="{StaticResource MarginMedium}" />
                        <TextBlock Text="{x:Static resources:Strings.ProxyNavigationFailed}"
                                   FontSize="{StaticResource FontSizeSubtitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="{StaticResource MarginMedium}" />
                        <ui:Button Content="{x:Static resources:Strings.ChangeProxy}"
                                   AutomationProperties.AutomationId="LoginWindow_ChangeProxyButton"
                                   Appearance="Primary"
                                   HorizontalAlignment="Center"
                                   Margin="{StaticResource MarginMedium}"
                                   Click="OnChangeProxyClick" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
