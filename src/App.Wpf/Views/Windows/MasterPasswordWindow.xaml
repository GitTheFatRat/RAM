<ui:FluentWindow x:Class="RbxManager.App.Views.Windows.MasterPasswordWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:resources="clr-namespace:RbxManager.App.Resources"
                  Title="{x:Static resources:Strings.MasterPasswordTitle}"
                  Height="300"
                  Width="440"
                  Icon="pack://application:,,,/RbxManager.App;component/Assets/app.ico"
                  WindowStartupLocation="CenterScreen"
                  ResizeMode="NoResize">
    <Grid Margin="{StaticResource MarginLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{x:Static resources:Strings.MasterPasswordTitle}"
                     Icon="{ui:ImageIcon 'pack://application:,,,/RbxManager.App;component/Assets/app.ico'}"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="{StaticResource MarginBottomMedium}">
            <TextBlock Text="{x:Static resources:Strings.MasterPasswordPrompt}"
                       TextWrapping="Wrap"
                       Margin="{StaticResource MarginBottomMedium}" />

            <ui:PasswordBox x:Name="MasterPasswordBox"
                            AutomationProperties.AutomationId="MasterPassword_PasswordBox"
                            Margin="{StaticResource MarginFieldGap}" />

            <TextBlock x:Name="ErrorTextBlock"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="{StaticResource MarginBottomMedium}">
            <ui:Button Content="{x:Static resources:Strings.MasterPasswordUnlockButton}"
                       AutomationProperties.AutomationId="MasterPassword_UnlockButton"
                       Appearance="Primary"
                       IsDefault="True"
                       Click="OnUnlockClicked"
                       Margin="{StaticResource MarginTight}" />
            <ui:Button Content="{x:Static resources:Strings.MasterPasswordExitButton}"
                       AutomationProperties.AutomationId="MasterPassword_ExitButton"
                       IsCancel="True"
                       Click="OnExitClicked" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
