<UserControl x:Class="RbxManager.App.Views.Controls.BackupPasswordDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:resources="clr-namespace:RbxManager.App.Resources">
    <StackPanel Margin="{StaticResource PaddingDialog}" Width="360">
        <TextBlock x:Name="MessageTextBlock"
                   Text="{x:Static resources:Strings.BackupPasswordMessage}"
                   TextWrapping="Wrap"
                   Margin="{StaticResource MarginBottomMedium}" />

        <TextBlock Text="{x:Static resources:Strings.BackupPasswordTitle}"
                   FontWeight="Medium"
                   Margin="{StaticResource MarginLabelGap}" />
        <PasswordBox x:Name="PasswordInput"
                     AutomationProperties.AutomationId="BackupPassword_PasswordBox"
                     Margin="{StaticResource MarginFieldGap}" />

        <StackPanel x:Name="ConfirmContainer">
            <TextBlock Text="{x:Static resources:Strings.PasswordConfirmLabel}"
                       FontWeight="Medium"
                       Margin="{StaticResource MarginLabelGap}" />
            <PasswordBox x:Name="ConfirmPasswordInput"
                         AutomationProperties.AutomationId="BackupPassword_ConfirmPasswordBox"
                         Margin="{StaticResource MarginFieldGap}" />
        </StackPanel>

        <TextBlock x:Name="ErrorTextBlock"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   FontSize="{StaticResource FontSizeCaption}"
                   Visibility="Collapsed"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
