<UserControl x:Class="RbxManager.App.Views.Controls.AccountPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             MinWidth="380"
             MaxHeight="400">
    <Grid Margin="{StaticResource MarginTopBase}">
        <ListView x:Name="AccountsListView"
                  AutomationProperties.AutomationId="AccountPicker_ListView"
                  SelectionMode="Multiple"
                  ItemsSource="{Binding Accounts}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected}"
                              AutomationProperties.AutomationId="AccountPicker_ItemCheckBox"
                              AutomationProperties.Name="{Binding Account.Alias}"
                              Margin="{StaticResource MarginTight}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Account.Alias}" FontWeight="SemiBold" Margin="{StaticResource MarginBase}" />
                            <TextBlock Text="{Binding Account.Username}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
