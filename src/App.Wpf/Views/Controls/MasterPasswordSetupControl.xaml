<UserControl x:Class="RbxManager.App.Views.Controls.MasterPasswordSetupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:resources="clr-namespace:RbxManager.App.Resources"
             MinWidth="380">
    <StackPanel Margin="0,8,0,0">
        <StackPanel Margin="0,0,0,12">
            <TextBlock Margin="0,0,0,4"
                       Text="{x:Static resources:Strings.SetupMasterPasswordPrompt}"
                       FontWeight="SemiBold" />
            <ui:PasswordBox x:Name="MasterPasswordBox"
                            AutomationProperties.AutomationId="MasterPasswordSetup_PasswordBox" />
        </StackPanel>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Margin="0,0,0,4"
                       Text="{x:Static resources:Strings.MasterPasswordConfirmPrompt}"
                       FontWeight="SemiBold" />
            <ui:PasswordBox x:Name="ConfirmPasswordBox"
                            AutomationProperties.AutomationId="MasterPasswordSetup_ConfirmPasswordBox" />
        </StackPanel>

        <TextBlock Margin="0,0,0,10"
                   Text="{x:Static resources:Strings.MasterPasswordBackupAdvice}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   FontSize="{StaticResource FontSizeCaption}"
                   TextWrapping="Wrap" />

        <CheckBox x:Name="AcknowledgeIrreversibleCheckBox"
                  AutomationProperties.AutomationId="MasterPasswordSetup_AcknowledgeCheckBox"
                  Margin="0,0,0,12">
            <TextBlock Text="{x:Static resources:Strings.MasterPasswordAcknowledgeWarning}"
                       TextWrapping="Wrap"
                       FontSize="{StaticResource FontSizeCaption}" />
        </CheckBox>

        <TextBlock x:Name="ErrorTextBlock"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />
    </StackPanel>
</UserControl>
