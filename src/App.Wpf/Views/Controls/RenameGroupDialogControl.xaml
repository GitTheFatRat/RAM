<UserControl x:Class="RbxManager.App.Views.Controls.RenameGroupDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:resources="clr-namespace:RbxManager.App.Resources">
    <StackPanel Margin="{StaticResource PaddingDialog}" Width="360">
        <TextBlock x:Name="CurrentGroupTextBlock"
                   FontWeight="Medium"
                   Margin="{StaticResource MarginFieldGap}" />

        <TextBlock Text="{x:Static resources:Strings.NewGroupNameLabel}"
                   FontWeight="Medium"
                   Margin="{StaticResource MarginLabelGap}" />
        <TextBox x:Name="NewGroupNameInput"
                 AutomationProperties.AutomationId="RenameGroup_NameBox"
                 MaxLength="30"
                 Margin="{StaticResource MarginFieldGap}" />

        <TextBlock x:Name="ErrorTextBlock"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   FontSize="{StaticResource FontSizeCaption}"
                   Visibility="Collapsed" />
    </StackPanel>
</UserControl>
