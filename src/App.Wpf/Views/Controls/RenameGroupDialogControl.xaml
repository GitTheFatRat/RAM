<UserControl x:Class="RbxManager.App.Views.Controls.RenameGroupDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:resources="clr-namespace:RbxManager.App.Resources">
    <StackPanel Margin="16" Width="360">
        <TextBlock x:Name="CurrentGroupTextBlock"
                   FontWeight="Medium"
                   Margin="0,0,0,12" />

        <TextBlock Text="{x:Static resources:Strings.NewGroupNameLabel}"
                   FontWeight="Medium"
                   Margin="0,0,0,6" />
        <TextBox x:Name="NewGroupNameInput"
                 AutomationProperties.AutomationId="RenameGroup_NameBox"
                 MaxLength="30"
                 Margin="0,0,0,12" />

        <TextBlock x:Name="ErrorTextBlock"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   FontSize="12"
                   Visibility="Collapsed" />
    </StackPanel>
</UserControl>
