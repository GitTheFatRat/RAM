<UserControl x:Class="RbxManager.App.Views.Controls.AccountEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:resources="clr-namespace:RbxManager.App.Resources"
             xmlns:viewModels="clr-namespace:RbxManager.App.ViewModels"
             d:DataContext="{d:DesignInstance viewModels:AccountEditorViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             MinWidth="460">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <StackPanel Margin="0,8,0,0">
        <TabControl Margin="0,0,0,12">
            <!-- General Tab -->
            <TabItem Header="{x:Static resources:Strings.TabGeneral}">
                <StackPanel Margin="0,12,0,0">
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Margin="0,0,0,4"
                                   Text="{x:Static resources:Strings.FieldAlias}"
                                   FontWeight="SemiBold" />
                        <ui:TextBox AutomationProperties.AutomationId="AccountEditor_AliasBox"
                                    Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}"
                                    MaxLength="50" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Margin="0,0,0,4"
                                   Text="{x:Static resources:Strings.FieldGroup}"
                                   FontWeight="SemiBold" />
                        <ComboBox AutomationProperties.AutomationId="AccountEditor_GroupBox"
                                  Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding AvailableGroups}"
                                  IsEditable="True" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Margin="0,0,0,4"
                                   Text="{x:Static resources:Strings.FieldNote}"
                                   FontWeight="SemiBold" />
                        <ui:TextBox AutomationProperties.AutomationId="AccountEditor_NoteBox"
                                    Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                    MaxLength="200" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Margin="0,0,0,4"
                                   Text="{x:Static resources:Strings.FieldCookie}"
                                   FontWeight="SemiBold" />
                        <ui:PasswordBox x:Name="CookieBox"
                                        AutomationProperties.AutomationId="AccountEditor_CookieBox" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Proxy Tab -->
            <TabItem Header="{x:Static resources:Strings.TabProxy}">
                <StackPanel Margin="0,12,0,0">
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Margin="0,0,0,4"
                                   Text="{x:Static resources:Strings.ProxyType}"
                                   FontWeight="SemiBold" />
                        <ComboBox AutomationProperties.AutomationId="AccountEditor_ProxyTypeBox"
                                  ItemsSource="{Binding AvailableProxyTypes}"
                                  SelectedItem="{Binding SelectedProxyType}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Margin="0,0,0,4"
                                   Text="{x:Static resources:Strings.ProxyHost}"
                                   FontWeight="SemiBold" />
                        <ui:TextBox AutomationProperties.AutomationId="AccountEditor_ProxyHostBox"
                                    Text="{Binding ProxyHost, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="127.0.0.1 or proxy.example.com" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Margin="0,0,0,4"
                                   Text="{x:Static resources:Strings.ProxyPort}"
                                   FontWeight="SemiBold" />
                        <ui:TextBox AutomationProperties.AutomationId="AccountEditor_ProxyPortBox"
                                    Text="{Binding ProxyPort, UpdateSourceTrigger=PropertyChanged}"
                                    MaxLength="5" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Margin="0,0,0,4"
                                   Text="{x:Static resources:Strings.ProxyUsername}"
                                   FontWeight="SemiBold" />
                        <ui:TextBox AutomationProperties.AutomationId="AccountEditor_ProxyUsernameBox"
                                    Text="{Binding ProxyUsername, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Margin="0,0,0,4"
                                   Text="{x:Static resources:Strings.ProxyPassword}"
                                   FontWeight="SemiBold" />
                        <ui:PasswordBox x:Name="ProxyPasswordBox"
                                        AutomationProperties.AutomationId="AccountEditor_ProxyPasswordBox" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasErrorMessage, Converter={StaticResource BoolToVis}}" />
    </StackPanel>
</UserControl>
