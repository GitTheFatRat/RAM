<UserControl x:Class="RbxManager.App.Views.Controls.AccountEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:resources="clr-namespace:RbxManager.App.Resources"
             xmlns:viewModels="clr-namespace:RbxManager.App.ViewModels"
             d:DataContext="{d:DesignInstance viewModels:AccountEditorViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             MinWidth="420">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <StackPanel Margin="0,8,0,0">
        <StackPanel Margin="0,0,0,12">
            <TextBlock Margin="0,0,0,4"
                       Text="{x:Static resources:Strings.FieldAlias}"
                       FontWeight="SemiBold" />
            <ui:TextBox Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="50" />
        </StackPanel>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Margin="0,0,0,4"
                       Text="{x:Static resources:Strings.FieldGroup}"
                       FontWeight="SemiBold" />
            <ui:TextBox Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="30" />
        </StackPanel>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Margin="0,0,0,4"
                       Text="{x:Static resources:Strings.FieldNote}"
                       FontWeight="SemiBold" />
            <ui:TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="200" />
        </StackPanel>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Margin="0,0,0,4"
                       Text="{x:Static resources:Strings.FieldCookie}"
                       FontWeight="SemiBold" />
            <ui:PasswordBox x:Name="CookieBox" />
        </StackPanel>

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasErrorMessage, Converter={StaticResource BoolToVis}}" />
    </StackPanel>
</UserControl>
