<UserControl x:Class="RbxManager.App.Views.Controls.LaunchDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:RbxManager.App.Resources"
             MinWidth="400">
    <StackPanel Margin="0,8,0,0">
        <StackPanel Margin="0,0,0,12">
            <TextBlock Margin="0,0,0,4"
                       Text="{x:Static res:Strings.PlaceIdLabel}"
                       FontWeight="SemiBold" />
            <ui:TextBox x:Name="PlaceIdTextBox"
                        AutomationProperties.AutomationId="LaunchDialog_PlaceIdBox"
                        PreviewTextInput="OnPlaceIdPreviewTextInput" />
        </StackPanel>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Margin="0,0,0,4"
                       Text="{x:Static res:Strings.JobIdLabel}"
                       FontWeight="SemiBold" />
            <ui:TextBox x:Name="JobIdTextBox"
                        AutomationProperties.AutomationId="LaunchDialog_JobIdBox" />
        </StackPanel>

        <ui:Button x:Name="DryRunButton"
                   AutomationProperties.AutomationId="LaunchDialog_DryRunButton"
                   Content="{x:Static res:Strings.DryRun}"
                   Click="OnDryRunButtonClick"
                   Margin="0,0,0,12" />

        <StackPanel x:Name="DryRunResultPanel"
                    Margin="0,0,0,12"
                    Visibility="Collapsed">
            <TextBlock Margin="0,0,0,4"
                       Text="{x:Static res:Strings.DryRunResultTitle}"
                       FontWeight="SemiBold" />
            <ui:TextBox x:Name="DryRunResultTextBox"
                        AutomationProperties.AutomationId="LaunchDialog_DryRunResultBox"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        MaxHeight="120"
                        VerticalScrollBarVisibility="Auto" />
        </StackPanel>

        <TextBlock x:Name="ErrorTextBlock"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />
    </StackPanel>
</UserControl>
