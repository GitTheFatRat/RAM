<Page x:Class="RbxManager.App.Views.Pages.RunningPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:RbxManager.App.Resources"
      xmlns:vm="clr-namespace:RbxManager.App.ViewModels"
      d:DataContext="{d:DesignInstance vm:RunningViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="{x:Static res:Strings.RunningPageTitle}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="{StaticResource MarginLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <TextBlock Grid.Row="0"
                   Text="{x:Static res:Strings.RunningPageTitle}"
                   Style="{StaticResource PageTitleStyle}"
                   Margin="{StaticResource MarginBottomMedium}" />

        <!-- Controls Bar -->
        <Grid Grid.Row="1" Margin="{StaticResource MarginBase}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Group rotation: farm groups in turn, closing + cleaning between them -->
            <Expander Grid.Column="0"
                      AutomationProperties.AutomationId="Running_RotationExpander"
                      Header="{x:Static res:Strings.RotationSectionTitle}"
                      Margin="0,0,16,0">
                <StackPanel Margin="4,8,4,4">
                    <TextBlock Text="{x:Static res:Strings.RotationGroupsLabel}"
                               FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding RotationGroups}"
                                  AutomationProperties.AutomationId="Running_RotationGroups"
                                  IsEnabled="{Binding IsRotationIdle}"
                                  Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayName}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Margin="0,0,16,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{x:Static res:Strings.RotationNoGroups}"
                               Style="{StaticResource DescriptionTextStyle}"
                               Visibility="{Binding HasNoRotationGroups, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,0"
                                IsEnabled="{Binding IsRotationIdle}">
                        <TextBlock Text="{x:Static res:Strings.RotationDurationLabel}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox Width="64"
                                 AutomationProperties.AutomationId="Running_RotationHours"
                                 AutomationProperties.Name="{x:Static res:Strings.RotationHoursSuffix}"
                                 Text="{Binding RotationHours, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static res:Strings.RotationHoursSuffix}"
                                   VerticalAlignment="Center"
                                   Margin="6,0,12,0" />
                        <TextBox Width="64"
                                 AutomationProperties.AutomationId="Running_RotationMinutes"
                                 AutomationProperties.Name="{x:Static res:Strings.RotationMinutesSuffix}"
                                 Text="{Binding RotationMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static res:Strings.RotationMinutesSuffix}"
                                   VerticalAlignment="Center"
                                   Margin="6,0,24,0" />
                        <ui:TextBox Width="160"
                                    AutomationProperties.AutomationId="Running_RotationPlaceId"
                                    PlaceholderText="{x:Static res:Strings.PlaceIdLabel}"
                                    Text="{Binding RotationPlaceIdText, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ui:Button AutomationProperties.AutomationId="Running_RotationStartButton"
                                   Content="{x:Static res:Strings.RotationStart}"
                                   Icon="{ui:SymbolIcon ArrowRepeatAll24}"
                                   Appearance="Primary"
                                   Command="{Binding StartRotationCommand}"
                                   Visibility="{Binding IsRotationIdle, Converter={StaticResource BoolToVis}}" />
                        <ui:Button AutomationProperties.AutomationId="Running_RotationStopButton"
                                   Content="{x:Static res:Strings.RotationStop}"
                                   Icon="{ui:SymbolIcon Stop24}"
                                   Appearance="Danger"
                                   Command="{Binding StopRotationCommand}"
                                   Visibility="{Binding IsRotationRunning, Converter={StaticResource BoolToVis}}" />
                        <TextBlock AutomationProperties.AutomationId="Running_RotationStatus"
                                   Text="{Binding RotationStatusText}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{x:Static res:Strings.RotationHint}"
                               Style="{StaticResource DescriptionTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Expander>

            <ui:Button Grid.Column="1"
                       VerticalAlignment="Top"
                       AutomationProperties.AutomationId="Running_CloseAllButton"
                       Content="{x:Static res:Strings.CloseAll}"
                       Icon="{ui:SymbolIcon Dismiss24}"
                       Appearance="Danger"
                       Command="{Binding CloseAllSessionsCommand}"
                       IsEnabled="{Binding HasSessions}" />
        </Grid>

        <!-- Main Content Area: Elevated Container -->
        <Border Grid.Row="2" Style="{StaticResource ElevatedContainerStyle}">
            <Grid>
                <!-- Data Grid -->
                <ui:DataGrid ItemsSource="{Binding Sessions}"
                             AutomationProperties.AutomationId="Running_DataGrid"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             IsReadOnly="True"
                             SelectionMode="Single"
                             GridLinesVisibility="None"
                             RowHeight="36"
                             Background="{DynamicResource CardBackgroundBrush}"
                             RowBackground="{DynamicResource ControlFillColorDefaultBrush}"
                             AlternatingRowBackground="{DynamicResource ControlFillColorSecondaryBrush}"
                             AlternationCount="2"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             ColumnHeaderStyle="{StaticResource HighContrastColumnHeaderStyle}"
                             RowStyle="{StaticResource HighContrastDataGridRowStyle}"
                             CellStyle="{StaticResource HighContrastDataGridCellStyle}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.CanContentScroll="True">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static res:Strings.ColumnAlias}"
                                        Binding="{Binding Alias}"
                                        Width="140"
                                        MinWidth="100" />
                    <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnPid}"
                                            Width="80"
                                            MinWidth="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Pid}"
                                           Style="{StaticResource MonospaceTextStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnPlace}"
                                            Width="120"
                                            MinWidth="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PlaceId}"
                                           Style="{StaticResource MonospaceTextStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{x:Static res:Strings.ColumnStarted}"
                                        Binding="{Binding StartedFormatted}"
                                        Width="130"
                                        MinWidth="100" />
                    <DataGridTextColumn Header="{x:Static res:Strings.ColumnUptime}"
                                        Binding="{Binding UptimeFormatted}"
                                        Width="130"
                                        MinWidth="100" />
                    <DataGridTextColumn Header="{x:Static res:Strings.ColumnMemory}"
                                        Binding="{Binding MemoryMb, StringFormat='{}{0} MB'}"
                                        Width="110"
                                        MinWidth="80" />
                    <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnAutoRejoin}"
                                            Width="130"
                                            MinWidth="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding AutoRejoin, Mode=TwoWay}"
                                              Margin="{StaticResource MarginTight}" />
                                    <ui:InfoBadge Severity="Critical"
                                                  Value="{x:Static res:Strings.RejoinGaveUp}"
                                                  Visibility="{Binding GaveUpVisibility}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnAction}"
                                            Width="*"
                                            MinWidth="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button Content="{x:Static res:Strings.CloseAction}"
                                           Icon="{ui:SymbolIcon Dismiss24}"
                                           Appearance="Secondary"
                                           Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=ui:DataGrid}}"
                                           CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </ui:DataGrid.Columns>
            </ui:DataGrid>

                <!-- Empty State Overlay -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="AppGeneric24"
                                   FontSize="48"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="{StaticResource MarginMedium}"
                                   Opacity="0.6" />
                    <TextBlock Text="{x:Static res:Strings.NoRunningSessions}"
                               Style="{StaticResource EmptyStateTitleStyle}" />
                    <TextBlock Text="{x:Static res:Strings.Running_EmptyHint}"
                               Style="{StaticResource EmptyStateHintStyle}" />
                </StackPanel>
        </Grid>
    </Border>
</Grid>
</Page>
