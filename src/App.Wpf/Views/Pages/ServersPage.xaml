<Page x:Class="RbxManager.App.Views.Pages.ServersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:RbxManager.App.Resources"
      xmlns:vm="clr-namespace:RbxManager.App.ViewModels"
      d:DataContext="{d:DesignInstance vm:ServersViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="{x:Static res:Strings.ServersPageTitle}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="10,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Single Compact Toolbar Bar: Query, Sort, Refresh/LoadMore, Follow Target & Live Join Status -->
        <Border Grid.Row="0"
                AutomationProperties.AutomationId="Servers_CompactToolbar"
                Style="{StaticResource CommandBarCardStyle}"
                Padding="10,6"
                Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Page Icon + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Border Style="{StaticResource SectionIconBadgeStyle}">
                        <ui:SymbolIcon Symbol="Server24"
                                       FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{x:Static res:Strings.ServersPageTitle}"
                               Style="{StaticResource PageTitleStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <ui:TextBox Grid.Column="1"
                            AutomationProperties.AutomationId="Servers_PlaceIdBox"
                            Text="{Binding PlaceIdText, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{x:Static res:Strings.PlaceIdLabel}"
                            Icon="{ui:SymbolIcon Games24}"
                            Width="160"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0" />

                <ComboBox Grid.Column="2"
                          AutomationProperties.AutomationId="Servers_SortComboBox"
                          SelectedIndex="{Binding SelectedSortIndex}"
                          Width="150"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0">
                    <ComboBoxItem Content="{x:Static res:Strings.SortAscending}" />
                    <ComboBoxItem Content="{x:Static res:Strings.SortDescending}" />
                </ComboBox>

                <ui:Button Grid.Column="3"
                           AutomationProperties.AutomationId="Servers_RefreshButton"
                           Content="{x:Static res:Strings.Refresh}"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Appearance="Primary"
                           Padding="10,5"
                           CornerRadius="{StaticResource RadiusMedium}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           Command="{Binding RefreshCommand}" />

                <ui:Button Grid.Column="4"
                           AutomationProperties.AutomationId="Servers_LoadMoreButton"
                           Content="{x:Static res:Strings.LoadMore}"
                           Icon="{ui:SymbolIcon ArrowDown24}"
                           Padding="10,5"
                           CornerRadius="{StaticResource RadiusMedium}"
                           VerticalAlignment="Center"
                           Command="{Binding LoadMoreCommand}"
                           IsEnabled="{Binding HasNextPage}" />

                <Border Grid.Column="5" Style="{StaticResource ToolbarSeparatorStyle}" Margin="8,0" />

                <ui:TextBox Grid.Column="6"
                            AutomationProperties.AutomationId="Servers_FollowTargetBox"
                            Text="{Binding FollowTargetUsername, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{x:Static res:Strings.FollowTargetLabel}"
                            ToolTip="{x:Static res:Strings.FollowTargetHint}"
                            Icon="{ui:SymbolIcon Person24}"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0" />

                <ui:Button Grid.Column="7"
                           AutomationProperties.AutomationId="Servers_FollowTargetButton"
                           Content="{x:Static res:Strings.FollowTargetJoin}"
                           Icon="{ui:SymbolIcon Play24}"
                           Appearance="Success"
                           Padding="12,5"
                           CornerRadius="{StaticResource RadiusMedium}"
                           VerticalAlignment="Center"
                           Command="{Binding FollowTargetCommand}" />

                <!-- Join queue status -->
                <Border Grid.Column="8"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSmall}"
                        Padding="8,3"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsJoining, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True"
                                         Width="14"
                                         Height="14"
                                         Margin="0,0,6,0" />
                        <TextBlock AutomationProperties.AutomationId="Servers_JoinStatusText"
                                   Text="{Binding JoinStatusText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ui:Button AutomationProperties.AutomationId="Servers_CancelJoinButton"
                                   AutomationProperties.Name="{x:Static res:Strings.Cancel}"
                                   Content="{x:Static res:Strings.Cancel}"
                                   Icon="{ui:SymbolIcon Dismiss24}"
                                   Padding="6,2"
                                   Command="{Binding CancelJoinCommand}"
                                   Margin="6,0,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Viewport-Fitted Server Grid Area -->
        <Border Grid.Row="1" Style="{StaticResource ElevatedContainerStyle}">
            <Grid>
                <ui:DataGrid ItemsSource="{Binding Servers}"
                             AutomationProperties.AutomationId="Servers_DataGrid"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             IsReadOnly="True"
                             SelectionMode="Single"
                             GridLinesVisibility="None"
                             RowHeight="28"
                             Background="{DynamicResource CardBackgroundBrush}"
                             RowBackground="{DynamicResource ControlFillColorDefaultBrush}"
                             AlternatingRowBackground="{DynamicResource ControlFillColorSecondaryBrush}"
                             AlternationCount="2"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             ColumnHeaderStyle="{StaticResource HighContrastColumnHeaderStyle}"
                             RowStyle="{StaticResource HighContrastDataGridRowStyle}"
                             CellStyle="{StaticResource HighContrastDataGridCellStyle}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ui:DataGrid.Columns>
                        <!-- Server ID (Monospace) -->
                        <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnServerId}"
                                                Width="300"
                                                MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Id}"
                                               Margin="8,0"
                                               Style="{StaticResource MonospaceTextStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnPlayers}"
                                                SortMemberPath="Playing"
                                                Width="120"
                                                MinWidth="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusPill}"
                                            Padding="8,1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} / {1}">
                                                    <Binding Path="Playing" />
                                                    <Binding Path="MaxPlayers" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{x:Static res:Strings.ColumnFps}"
                                            Binding="{Binding Fps, StringFormat='{}{0:F1}'}"
                                            Width="90"
                                            MinWidth="70" />
                        <DataGridTextColumn Header="{x:Static res:Strings.ColumnPing}"
                                            Binding="{Binding Ping, StringFormat='{}{0} ms'}"
                                            Width="100"
                                            MinWidth="75" />
                        <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnAction}"
                                                Width="*"
                                                MinWidth="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Content="{x:Static res:Strings.JoinWithAccount}"
                                                   AutomationProperties.Name="{x:Static res:Strings.JoinWithAccount}"
                                                   Icon="{ui:SymbolIcon Play24}"
                                                   Appearance="Success"
                                                   Padding="10,2"
                                                   CornerRadius="{StaticResource RadiusSmall}"
                                                   Margin="0,0,6,0"
                                                   Command="{Binding DataContext.JoinWithAccountCommand, RelativeSource={RelativeSource AncestorType=ui:DataGrid}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Content="{x:Static res:Strings.CopyServerId}"
                                                   AutomationProperties.Name="{x:Static res:Strings.CopyServerId}"
                                                   Icon="{ui:SymbolIcon Copy24}"
                                                   Padding="8,2"
                                                   CornerRadius="{StaticResource RadiusSmall}"
                                                   Command="{Binding DataContext.CopyServerIdCommand, RelativeSource={RelativeSource AncestorType=ui:DataGrid}}"
                                                   CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </ui:DataGrid.Columns>
                </ui:DataGrid>

                <!-- Loading indicator -->
                <ProgressBar IsIndeterminate="True"
                             Height="3"
                             VerticalAlignment="Top"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

                <!-- Empty State Overlay -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="Server24"
                                   FontSize="36"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="{StaticResource MarginBase}"
                                   Opacity="0.6" />
                    <TextBlock Text="{x:Static res:Strings.NoServersFound}"
                               Style="{StaticResource EmptyStateTitleStyle}" />
                    <TextBlock Text="{x:Static res:Strings.Servers_EmptyHint}"
                               Style="{StaticResource EmptyStateHintStyle}" />
                </StackPanel>

                <!-- Error State with Retry Button -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="Warning24"
                                   FontSize="36"
                                   Foreground="{DynamicResource StatusErrorForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="{StaticResource MarginBase}" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource EmptyStateTitleStyle}" />
                    <TextBlock Text="{x:Static res:Strings.Servers_ErrorHint}"
                               Style="{StaticResource EmptyStateHintStyle}" />
                    <ui:Button Content="{x:Static res:Strings.Retry}"
                               AutomationProperties.AutomationId="Servers_RetryButton"
                               AutomationProperties.Name="{x:Static res:Strings.Retry}"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Appearance="Primary"
                               HorizontalAlignment="Center"
                               Margin="{StaticResource MarginTight}"
                               Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
