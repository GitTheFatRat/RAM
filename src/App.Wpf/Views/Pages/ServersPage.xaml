<Page x:Class="RbxManager.App.Views.Pages.ServersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:RbxManager.App.Resources"
      xmlns:vm="clr-namespace:RbxManager.App.ViewModels"
      d:DataContext="{d:DesignInstance vm:ServersViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="{x:Static res:Strings.ServersPageTitle}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="{StaticResource MarginLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <TextBlock Grid.Row="0"
                   Text="{x:Static res:Strings.ServersPageTitle}"
                   Style="{StaticResource PageTitleStyle}"
                   Margin="{StaticResource MarginBottomMedium}" />

        <!-- Controls Toolbar -->
        <Grid Grid.Row="1" Margin="{StaticResource MarginBase}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0"
                        AutomationProperties.AutomationId="Servers_PlaceIdBox"
                        Text="{Binding PlaceIdText, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{x:Static res:Strings.PlaceIdLabel}"
                        Width="180"
                        Margin="{StaticResource MarginTight}" />

            <ComboBox Grid.Column="1"
                      AutomationProperties.AutomationId="Servers_SortComboBox"
                      SelectedIndex="{Binding SelectedSortIndex}"
                      Width="200"
                      Margin="{StaticResource MarginTight}">
                <ComboBoxItem Content="{x:Static res:Strings.SortAscending}" />
                <ComboBoxItem Content="{x:Static res:Strings.SortDescending}" />
            </ComboBox>

            <Border Grid.Column="2" Style="{StaticResource ToolbarSeparatorStyle}" />

            <ui:Button Grid.Column="3"
                       AutomationProperties.AutomationId="Servers_RefreshButton"
                       Content="{x:Static res:Strings.Refresh}"
                       Icon="{ui:SymbolIcon ArrowSync24}"
                       Appearance="Primary"
                       Margin="{StaticResource MarginTight}"
                       Command="{Binding RefreshCommand}" />

            <ui:Button Grid.Column="5"
                       AutomationProperties.AutomationId="Servers_LoadMoreButton"
                       Content="{x:Static res:Strings.LoadMore}"
                       Icon="{ui:SymbolIcon ArrowDown24}"
                       Command="{Binding LoadMoreCommand}"
                       IsEnabled="{Binding HasNextPage}" />
        </Grid>

        <!-- Data Grid Area: Elevated Container -->
        <Border Grid.Row="2" Style="{StaticResource ElevatedContainerStyle}">
            <Grid>
                <ui:DataGrid ItemsSource="{Binding Servers}"
                             AutomationProperties.AutomationId="Servers_DataGrid"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             IsReadOnly="True"
                             SelectionMode="Single"
                             GridLinesVisibility="None"
                             RowHeight="36"
                             Background="{DynamicResource CardBackgroundBrush}"
                             RowBackground="{DynamicResource ControlFillColorDefaultBrush}"
                             AlternatingRowBackground="{DynamicResource ControlFillColorSecondaryBrush}"
                             AlternationCount="2"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             ColumnHeaderStyle="{StaticResource HighContrastColumnHeaderStyle}"
                             RowStyle="{StaticResource HighContrastDataGridRowStyle}"
                             CellStyle="{StaticResource HighContrastDataGridCellStyle}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.CanContentScroll="True">
                <ui:DataGrid.Columns>
                    <!-- Server ID (Monospace) -->
                    <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnServerId}"
                                            Width="280">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Id}"
                                           Style="{StaticResource MonospaceTextStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnPlayers}"
                                            SortMemberPath="Playing"
                                            Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}/{1}">
                                            <Binding Path="Playing" />
                                            <Binding Path="MaxPlayers" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{x:Static res:Strings.ColumnFps}"
                                        Binding="{Binding Fps, StringFormat='{}{0:F1}'}"
                                        Width="100" />
                    <DataGridTextColumn Header="{x:Static res:Strings.ColumnPing}"
                                        Binding="{Binding Ping, StringFormat='{}{0} ms'}"
                                        Width="100" />
                    <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnAction}"
                                            Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="{x:Static res:Strings.JoinWithAccount}"
                                               Icon="{ui:SymbolIcon Play24}"
                                               Appearance="Success"
                                               Margin="{StaticResource MarginTight}"
                                               Command="{Binding DataContext.JoinWithAccountCommand, RelativeSource={RelativeSource AncestorType=ui:DataGrid}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Content="{x:Static res:Strings.CopyServerId}"
                                               Icon="{ui:SymbolIcon Copy24}"
                                               Command="{Binding DataContext.CopyServerIdCommand, RelativeSource={RelativeSource AncestorType=ui:DataGrid}}"
                                               CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </ui:DataGrid.Columns>
            </ui:DataGrid>

                <!-- Loading indicator -->
                <ProgressBar IsIndeterminate="True"
                             Height="4"
                             VerticalAlignment="Top"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

                <!-- Empty State Overlay -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="Server24"
                                   FontSize="48"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="{StaticResource MarginMedium}"
                                   Opacity="0.6" />
                    <TextBlock Text="{x:Static res:Strings.NoServersFound}"
                               Style="{StaticResource EmptyStateTitleStyle}" />
                    <TextBlock Text="{x:Static res:Strings.Servers_EmptyHint}"
                               Style="{StaticResource EmptyStateHintStyle}" />
                </StackPanel>

                <!-- Error State with Retry Button -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="Warning24"
                                   FontSize="48"
                                   Foreground="{DynamicResource StatusErrorForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="{StaticResource MarginMedium}" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource EmptyStateTitleStyle}" />
                    <TextBlock Text="{x:Static res:Strings.Servers_ErrorHint}"
                               Style="{StaticResource EmptyStateHintStyle}" />
                    <ui:Button Content="{x:Static res:Strings.Retry}"
                               AutomationProperties.AutomationId="Servers_RetryButton"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Appearance="Primary"
                               HorizontalAlignment="Center"
                               Margin="{StaticResource MarginBase}"
                               Command="{Binding RefreshCommand}" />
                </StackPanel>
        </Grid>
    </Border>
</Grid>
</Page>
