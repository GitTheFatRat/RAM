<Page x:Class="RbxManager.App.Views.Pages.ServersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:RbxManager.App.Resources"
      xmlns:vm="clr-namespace:RbxManager.App.ViewModels"
      d:DataContext="{d:DesignInstance vm:ServersViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="{x:Static res:Strings.ServersPageTitle}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="{x:Static res:Strings.ServersPageTitle}"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <!-- Controls -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0"
                        Text="{Binding PlaceIdText, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{x:Static res:Strings.PlaceIdLabel}"
                        Width="180"
                        Margin="0,0,12,0" />

            <ComboBox Grid.Column="1"
                      SelectedIndex="{Binding SelectedSortIndex}"
                      Width="200"
                      Margin="0,0,12,0">
                <ComboBoxItem Content="{x:Static res:Strings.SortAscending}" />
                <ComboBoxItem Content="{x:Static res:Strings.SortDescending}" />
            </ComboBox>

            <ui:Button Grid.Column="2"
                       Content="{x:Static res:Strings.Refresh}"
                       Icon="{ui:SymbolIcon ArrowSync24}"
                       Appearance="Primary"
                       Command="{Binding RefreshCommand}" />

            <ui:Button Grid.Column="4"
                       Content="{x:Static res:Strings.LoadMore}"
                       Icon="{ui:SymbolIcon ArrowDown24}"
                       Command="{Binding LoadMoreCommand}"
                       IsEnabled="{Binding HasNextPage}" />
        </Grid>

        <!-- Data Grid -->
        <Grid Grid.Row="2">
            <ui:DataGrid ItemsSource="{Binding Servers}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         GridLinesVisibility="Horizontal">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static res:Strings.ColumnServerId}"
                                        Binding="{Binding Id}"
                                        Width="260" />
                    <DataGridTextColumn Header="{x:Static res:Strings.ColumnPlayers}"
                                        Binding="{Binding StringFormat='{}{0}/{1}', Path=Playing, ConverterParameter={Binding MaxPlayers}}"
                                        Width="120" />
                    <DataGridTextColumn Header="{x:Static res:Strings.ColumnFps}"
                                        Binding="{Binding Fps, StringFormat='{}{0:F1}'}"
                                        Width="100" />
                    <DataGridTextColumn Header="{x:Static res:Strings.ColumnPing}"
                                        Binding="{Binding Ping, StringFormat='{}{0} ms'}"
                                        Width="100" />
                    <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnAction}"
                                            Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="{x:Static res:Strings.JoinWithAccount}"
                                               Icon="{ui:SymbolIcon Play24}"
                                               Appearance="Success"
                                               Margin="0,0,8,0"
                                               Command="{Binding DataContext.JoinWithAccountCommand, RelativeSource={RelativeSource AncestorType=ui:DataGrid}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Content="{x:Static res:Strings.CopyServerId}"
                                               Icon="{ui:SymbolIcon Copy24}"
                                               Command="{Binding DataContext.CopyServerIdCommand, RelativeSource={RelativeSource AncestorType=ui:DataGrid}}"
                                               CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </ui:DataGrid.Columns>
            </ui:DataGrid>

            <!-- Loading indicator -->
            <ProgressBar IsIndeterminate="True"
                         Height="4"
                         VerticalAlignment="Top"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

            <!-- Empty State Overlay -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BoolToVis}}">
                <ui:SymbolIcon Symbol="Server24"
                               FontSize="48"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12" />
                <TextBlock Text="{x:Static res:Strings.NoServersFound}"
                           FontSize="16"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
