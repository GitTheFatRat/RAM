<Page x:Class="RbxManager.App.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:RbxManager.App.Resources"
      Title="{x:Static resources:Strings.SettingsPageTitle}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Text="{x:Static resources:Strings.SettingsPageTitle}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,24" />

            <!-- Language Setting -->
            <TextBlock Text="{x:Static resources:Strings.LanguageLabel}"
                       FontWeight="Medium"
                       Margin="0,0,0,6" />
            <ComboBox SelectedValuePath="Tag"
                      SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                      Margin="0,0,0,16"
                      Width="260"
                      HorizontalAlignment="Left">
                <ComboBoxItem Content="Tiếng Việt (vi-VN)" Tag="vi" />
                <ComboBoxItem Content="English (en-US)" Tag="en" />
            </ComboBox>

            <!-- Theme Setting -->
            <TextBlock Text="{x:Static resources:Strings.ThemeLabel}"
                       FontWeight="Medium"
                       Margin="0,0,0,6" />
            <ComboBox SelectedValuePath="Tag"
                      SelectedValue="{Binding SelectedTheme, Mode=TwoWay}"
                      Margin="0,0,0,16"
                      Width="260"
                      HorizontalAlignment="Left">
                <ComboBoxItem Content="{x:Static resources:Strings.ThemeDark}" Tag="Dark" />
                <ComboBoxItem Content="{x:Static resources:Strings.ThemeLight}" Tag="Light" />
                <ComboBoxItem Content="{x:Static resources:Strings.ThemeSystem}" Tag="System" />
            </ComboBox>

            <!-- Launch Delay Setting -->
            <TextBlock Text="{x:Static resources:Strings.LaunchDelayLabel}"
                       FontWeight="Medium"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding LaunchDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="260"
                     HorizontalAlignment="Left"
                     Margin="0,0,0,16" />

            <!-- Rejoin Delay Setting -->
            <TextBlock Text="{x:Static resources:Strings.RejoinDelayLabel}"
                       FontWeight="Medium"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding RejoinDelaySeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="260"
                     HorizontalAlignment="Left"
                     Margin="0,0,0,16" />

            <!-- Rejoin Max Attempts Setting -->
            <TextBlock Text="{x:Static resources:Strings.RejoinMaxAttemptsLabel}"
                       FontWeight="Medium"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding RejoinMaxAttempts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="260"
                     HorizontalAlignment="Left"
                     Margin="0,0,0,16" />

            <!-- Multi-Instance Setting -->
            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    Margin="0,8,0,24">
                <StackPanel>
                    <TextBlock Text="{x:Static resources:Strings.MultiInstanceLabel}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Margin="0,0,0,6" />
                    <CheckBox Content="{x:Static resources:Strings.MultiInstanceLabel}"
                              IsChecked="{Binding MultiInstanceEnabled, Mode=TwoWay}"
                              IsEnabled="{Binding IsMultiInstanceAvailable}"
                              Margin="0,0,0,8" />
                    <TextBlock Text="{x:Static resources:Strings.MultiInstanceNotAvailable}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Advanced Expander -->
            <Expander Header="{x:Static resources:Strings.AdvancedSettingsTitle}"
                      Margin="0,0,0,24"
                      MaxWidth="600"
                      HorizontalAlignment="Left">
                <StackPanel Margin="12">
                    <TextBlock Text="{x:Static resources:Strings.AdvancedSettingsSubtitle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <TextBlock Text="{x:Static resources:Strings.LaunchUriTemplateStatus}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,2" />
                    <TextBlock Text="{Binding LaunchUriTemplateStatus}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,10" />

                    <TextBlock Text="{x:Static resources:Strings.PlaceLauncherUrlTemplateStatus}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,2" />
                    <TextBlock Text="{Binding PlaceLauncherUrlTemplateStatus}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Expander>

            <!-- Save Button -->
            <ui:Button Appearance="Primary"
                       Content="{x:Static resources:Strings.Save}"
                       Command="{Binding SaveSettingsCommand}"
                       Width="140"
                       HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</Page>
