<Page x:Class="RbxManager.App.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:RbxManager.App.Resources"
      xmlns:processes="clr-namespace:RbxManager.Core.Processes;assembly=RbxManager.Core"
      Title="{x:Static resources:Strings.SettingsPageTitle}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Page.Resources>
        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Margin="{StaticResource MarginLarge}">
        <Grid.RowDefinitions>
            <!-- Row 0: Page Title & Save Action Header -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Settings Cards Grid -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: Title and Save Action Bar -->
        <Grid Grid.Row="0" Margin="{StaticResource MarginBottomMedium}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{x:Static resources:Strings.SettingsPageTitle}"
                       Style="{StaticResource PageTitleStyle}"
                       VerticalAlignment="Center" />

            <ui:Button Grid.Column="1"
                       Appearance="Primary"
                       AutomationProperties.AutomationId="Settings_SaveButton"
                       AutomationProperties.Name="{x:Static resources:Strings.Save}"
                       Content="{x:Static resources:Strings.Save}"
                       Icon="{ui:SymbolIcon Save24}"
                       Command="{Binding SaveSettingsCommand}"
                       MinWidth="130"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Main Content: Settings Cards -->
        <StackPanel Grid.Row="1" MaxWidth="860" HorizontalAlignment="Left">

                <!-- ══════════════════════════════════════════════════════════
                     CARD 1: Giao diện (Appearance)
                     ══════════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Section Header -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="{StaticResource MarginBottomMedium}">
                            <TextBlock Text="{x:Static resources:Strings.AppearanceSectionTitle}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="{x:Static resources:Strings.AppearanceSectionSubtitle}"
                                       Style="{StaticResource DescriptionTextStyle}" />
                        </StackPanel>

                        <!-- Row 1: Language -->
                        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="{StaticResource MarginTight}">
                            <TextBlock Text="{x:Static resources:Strings.LanguageLabel}"
                                       Style="{StaticResource SettingLabelStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  SelectedValuePath="Tag"
                                  AutomationProperties.AutomationId="Settings_LanguageComboBox"
                                  AutomationProperties.Name="{x:Static resources:Strings.LanguageLabel}"
                                  SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                                  Width="260"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="Tiếng Việt (vi-VN)" Tag="vi" />
                            <ComboBoxItem Content="English (en-US)" Tag="en" />
                        </ComboBox>

                        <!-- Divider -->
                        <Rectangle Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                   Height="1"
                                   Fill="{DynamicResource DividerStrokeColorDefaultBrush}"
                                   Margin="0,8" />

                        <!-- Row 2: Theme -->
                        <StackPanel Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="{StaticResource MarginTight}">
                            <TextBlock Text="{x:Static resources:Strings.ThemeLabel}"
                                       Style="{StaticResource SettingLabelStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Row="3" Grid.Column="1"
                                  SelectedValuePath="Tag"
                                  AutomationProperties.AutomationId="Settings_ThemeComboBox"
                                  AutomationProperties.Name="{x:Static resources:Strings.ThemeLabel}"
                                  SelectedValue="{Binding SelectedTheme, Mode=TwoWay}"
                                  Width="260"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="{x:Static resources:Strings.ThemeDark}" Tag="Dark" />
                            <ComboBoxItem Content="{x:Static resources:Strings.ThemeLight}" Tag="Light" />
                            <ComboBoxItem Content="{x:Static resources:Strings.ThemeSystem}" Tag="System" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════════
                     CARD 2: Khởi chạy (Launching)
                     ══════════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Section Header -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="{StaticResource MarginBottomMedium}">
                            <TextBlock Text="{x:Static resources:Strings.LaunchingSectionTitle}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="{x:Static resources:Strings.LaunchingSectionSubtitle}"
                                       Style="{StaticResource DescriptionTextStyle}" />
                        </StackPanel>

                        <!-- Row 1: Launch Delay -->
                        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="{StaticResource MarginTight}">
                            <TextBlock Text="{x:Static resources:Strings.LaunchDelayLabel}"
                                       Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock Text="{x:Static resources:Strings.LaunchDelayDescription}"
                                       Style="{StaticResource DescriptionTextStyle}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:NumberBox Grid.Row="1" Grid.Column="1"
                                      AutomationProperties.AutomationId="Settings_LaunchDelayNumberBox"
                                      AutomationProperties.Name="{x:Static resources:Strings.LaunchDelayLabel}"
                                      Value="{Binding LaunchDelaySeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Minimum="1"
                                      Maximum="600"
                                      SpinButtonPlacementMode="Inline"
                                      Width="260"
                                      VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════════
                     CARD 3: Tự động vào lại (Auto-rejoin)
                     ══════════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Section Header -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="{StaticResource MarginBottomMedium}">
                            <TextBlock Text="{x:Static resources:Strings.AutoRejoinSectionTitle}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="{x:Static resources:Strings.AutoRejoinSectionSubtitle}"
                                       Style="{StaticResource DescriptionTextStyle}" />
                        </StackPanel>

                        <!-- Row 1: Rejoin Delay -->
                        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="{StaticResource MarginTight}">
                            <TextBlock Text="{x:Static resources:Strings.RejoinDelayLabel}"
                                       Style="{StaticResource SettingLabelStyle}" />
                        </StackPanel>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 AutomationProperties.AutomationId="Settings_RejoinDelayTextBox"
                                 AutomationProperties.Name="{x:Static resources:Strings.RejoinDelayLabel}"
                                 Text="{Binding RejoinDelaySeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="260"
                                 VerticalAlignment="Center" />

                        <!-- Divider 1 -->
                        <Rectangle Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                   Height="1"
                                   Fill="{DynamicResource DividerStrokeColorDefaultBrush}"
                                   Margin="0,8" />

                        <!-- Row 2: Rejoin Max Attempts -->
                        <StackPanel Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="{StaticResource MarginTight}">
                            <TextBlock Text="{x:Static resources:Strings.RejoinMaxAttemptsLabel}"
                                       Style="{StaticResource SettingLabelStyle}" />
                        </StackPanel>
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 AutomationProperties.AutomationId="Settings_RejoinMaxAttemptsTextBox"
                                 AutomationProperties.Name="{x:Static resources:Strings.RejoinMaxAttemptsLabel}"
                                 Text="{Binding RejoinMaxAttempts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="260"
                                 VerticalAlignment="Center" />

                        <!-- Divider 2 -->
                        <Rectangle Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                   Height="1"
                                   Fill="{DynamicResource DividerStrokeColorDefaultBrush}"
                                   Margin="0,8" />

                        <!-- Row 3: Smart Server Hopping -->
                        <StackPanel Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="{StaticResource MarginTight}">
                            <TextBlock Text="{x:Static resources:Strings.EnableSmartServerHopping}"
                                       Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock Text="{x:Static resources:Strings.EnableSmartServerHoppingDescription}"
                                       Style="{StaticResource DescriptionTextStyle}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Row="5" Grid.Column="1"
                                         AutomationProperties.AutomationId="Settings_SmartServerHoppingToggle"
                                         AutomationProperties.Name="{x:Static resources:Strings.EnableSmartServerHopping}"
                                         IsChecked="{Binding EnableSmartServerHopping, Mode=OneWay}"
                                         Command="{Binding EnableSmartServerHoppingToggledCommand}"
                                         CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}"
                                         VerticalAlignment="Center" />

                        <!-- Divider 3 -->
                        <Rectangle Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                                   Height="1"
                                   Fill="{DynamicResource DividerStrokeColorDefaultBrush}"
                                   Margin="0,8" />

                        <!-- Row 4: Ghost Disconnect Detection -->
                        <StackPanel Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Margin="{StaticResource MarginTight}">
                            <TextBlock Text="{x:Static resources:Strings.GhostDisconnectMode}"
                                       Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock Text="{x:Static resources:Strings.GhostDisconnectModeDescription}"
                                       Style="{StaticResource DescriptionTextStyle}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Row="7" Grid.Column="1"
                                  SelectedValuePath="Tag"
                                  AutomationProperties.AutomationId="Settings_GhostDisconnectComboBox"
                                  AutomationProperties.Name="{x:Static resources:Strings.GhostDisconnectMode}"
                                  SelectedValue="{Binding SelectedGhostDisconnectMode, Mode=TwoWay}"
                                  Width="260"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="{x:Static resources:Strings.GhostDisconnectMode_Off}" Tag="{x:Static processes:GhostDisconnectMode.Off}" />
                            <ComboBoxItem Content="{x:Static resources:Strings.GhostDisconnectMode_NotifyOnly}" Tag="{x:Static processes:GhostDisconnectMode.NotifyOnly}" />
                            <ComboBoxItem Content="{x:Static resources:Strings.GhostDisconnectMode_KillAndRejoin}" Tag="{x:Static processes:GhostDisconnectMode.KillAndRejoin}" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════════
                     CARD 4: Đa phiên bản (Multi-Instance)
                     ══════════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Section Header -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="{StaticResource MarginBottomMedium}">
                            <TextBlock Text="{x:Static resources:Strings.MultiInstanceSectionTitle}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="{x:Static resources:Strings.MultiInstanceSectionSubtitle}"
                                       Style="{StaticResource DescriptionTextStyle}" />
                        </StackPanel>

                        <!-- Row 1: Multi-Instance Toggle -->
                        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="{StaticResource MarginTight}">
                            <TextBlock Text="{x:Static resources:Strings.MultiInstanceLabel}"
                                       Style="{StaticResource SettingLabelStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Row="1" Grid.Column="1"
                                  AutomationProperties.AutomationId="Settings_MultiInstanceToggle"
                                  AutomationProperties.Name="{x:Static resources:Strings.MultiInstanceLabel}"
                                  IsChecked="{Binding MultiInstanceEnabled, Mode=TwoWay}"
                                  Command="{Binding MultiInstanceToggledCommand}"
                                  CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}"
                                  VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════════
                     CARD 5: Bảo mật (Security)
                     ══════════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Section Header -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="{StaticResource MarginBottomMedium}">
                            <TextBlock Text="{x:Static resources:Strings.SecuritySectionTitle}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="{x:Static resources:Strings.SecuritySectionSubtitle}"
                                       Style="{StaticResource DescriptionTextStyle}" />
                        </StackPanel>

                        <!-- Row 1: Master Password -->
                        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="{StaticResource MarginTight}">
                            <TextBlock Text="{x:Static resources:Strings.EnableMasterPassword}"
                                       Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock Text="{x:Static resources:Strings.EnableMasterPasswordDescription}"
                                       Style="{StaticResource DescriptionTextStyle}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Row="1" Grid.Column="1"
                                  AutomationProperties.AutomationId="Settings_MasterPasswordToggle"
                                  AutomationProperties.Name="{x:Static resources:Strings.EnableMasterPassword}"
                                  IsChecked="{Binding IsMasterPasswordEnabled, Mode=OneWay}"
                                  Command="{Binding MasterPasswordToggledCommand}"
                                  CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}"
                                  VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════════
                     CARD 6: Tối ưu tài nguyên & RAM (Performance & Optimization)
                     ══════════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Section Header -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="{StaticResource MarginBottomMedium}">
                            <TextBlock Text="{x:Static resources:Strings.ResourceOptimizationSectionTitle}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="{x:Static resources:Strings.ResourceOptimizationSectionSubtitle}"
                                       Style="{StaticResource DescriptionTextStyle}" />
                        </StackPanel>

                        <!-- Row 1: Throttle Background Roblox -->
                        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="{StaticResource MarginTight}">
                            <TextBlock Text="{x:Static resources:Strings.ThrottleBackgroundRoblox}"
                                       Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock Text="{x:Static resources:Strings.ThrottleBackgroundRobloxDescription}"
                                       Style="{StaticResource DescriptionTextStyle}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Row="1" Grid.Column="1"
                                  AutomationProperties.AutomationId="Settings_ThrottleRobloxCheckbox"
                                  AutomationProperties.Name="{x:Static resources:Strings.ThrottleBackgroundRoblox}"
                                  IsChecked="{Binding ThrottleBackgroundRoblox, Mode=OneWay}"
                                  Command="{Binding ThrottleBackgroundRobloxToggledCommand}"
                                  CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}"
                                  VerticalAlignment="Center" />

                        <!-- Divider 1 -->
                        <Rectangle Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                   Height="1"
                                   Fill="{DynamicResource DividerStrokeColorDefaultBrush}"
                                   Margin="0,8" />

                        <!-- Row 2: Smart RAM Cleaner -->
                        <StackPanel Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="{StaticResource MarginTight}">
                            <TextBlock Text="{x:Static resources:Strings.EnableRamCleaner}"
                                       Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock Text="{x:Static resources:Strings.EnableRamCleanerDescription}"
                                       Style="{StaticResource DescriptionTextStyle}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Row="3" Grid.Column="1"
                                         AutomationProperties.AutomationId="Settings_RamCleanerToggle"
                                         AutomationProperties.Name="{x:Static resources:Strings.EnableRamCleaner}"
                                         IsChecked="{Binding EnableRamCleaner, Mode=OneWay}"
                                         Command="{Binding EnableRamCleanerToggledCommand}"
                                         CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}"
                                         VerticalAlignment="Center" />

                        <!-- Divider 2 -->
                        <Rectangle Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                   Height="1"
                                   Fill="{DynamicResource DividerStrokeColorDefaultBrush}"
                                   Margin="0,8" />

                        <!-- Row 3: RAM Cleaner Interval -->
                        <StackPanel Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="{StaticResource MarginTight}">
                            <TextBlock Text="{x:Static resources:Strings.RamCleanerInterval}"
                                       Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock Text="{x:Static resources:Strings.RamCleanerIntervalDescription}"
                                       Style="{StaticResource DescriptionTextStyle}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider Width="180"
                                    AutomationProperties.AutomationId="Settings_RamCleanerSlider"
                                    AutomationProperties.Name="{x:Static resources:Strings.RamCleanerInterval}"
                                    Minimum="5"
                                    Maximum="120"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding RamCleanerIntervalMinutes, Mode=TwoWay}"
                                    IsEnabled="{Binding EnableRamCleaner}"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RamCleanerIntervalDisplay}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       MinWidth="60"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        <!-- Divider 3 -->
                        <Rectangle Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                                   Height="1"
                                   Fill="{DynamicResource DividerStrokeColorDefaultBrush}"
                                   Margin="0,8" />

                        <!-- Row 4: Force Custom Window Resolution Toggle -->
                        <StackPanel Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Margin="{StaticResource MarginTight}">
                            <TextBlock Text="{x:Static resources:Strings.EnableCustomResolution}"
                                       Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock Text="{x:Static resources:Strings.EnableCustomResolutionDescription}"
                                       Style="{StaticResource DescriptionTextStyle}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Row="7" Grid.Column="1"
                                         AutomationProperties.AutomationId="Settings_CustomResolutionToggle"
                                         AutomationProperties.Name="{x:Static resources:Strings.EnableCustomResolution}"
                                         IsChecked="{Binding EnableCustomResolution, Mode=TwoWay}"
                                         Command="{Binding EnableCustomResolutionToggledCommand}"
                                         CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}"
                                         VerticalAlignment="Center" />

                        <!-- Row 5: Custom Resolution Width & Height -->
                        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Margin="4,8,4,0"
                                    IsEnabled="{Binding EnableCustomResolution}">
                            <TextBlock Text="{x:Static resources:Strings.ResolutionWidthLabel}"
                                       Style="{StaticResource SettingLabelStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBox Width="140"
                                     AutomationProperties.AutomationId="Settings_ResolutionWidthTextBox"
                                     AutomationProperties.Name="{x:Static resources:Strings.ResolutionWidthLabel}"
                                     Text="{Binding ResolutionWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,24,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static resources:Strings.ResolutionHeightLabel}"
                                       Style="{StaticResource SettingLabelStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBox Width="140"
                                     AutomationProperties.AutomationId="Settings_ResolutionHeightTextBox"
                                     AutomationProperties.Name="{x:Static resources:Strings.ResolutionHeightLabel}"
                                     Text="{Binding ResolutionHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════════
                     CARD 7: Sao lưu & Khôi phục (Backup & Restore)
                     ══════════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Section Header -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="{StaticResource MarginBottomMedium}">
                            <TextBlock Text="{x:Static resources:Strings.BackupSectionTitle}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="{x:Static resources:Strings.BackupSectionSubtitle}"
                                       Style="{StaticResource DescriptionTextStyle}" />
                        </StackPanel>

                        <!-- Actions -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{x:Static resources:Strings.BackupSectionSubtitle}"
                                   Style="{StaticResource DescriptionTextStyle}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Content="{x:Static resources:Strings.ExportBackup}"
                                       AutomationProperties.AutomationId="Settings_ExportBackupButton"
                                       AutomationProperties.Name="{x:Static resources:Strings.ExportBackup}"
                                       Icon="{ui:SymbolIcon ArrowUpload24}"
                                       Margin="0,0,8,0"
                                       Command="{Binding ExportBackupCommand}" />
                            <ui:Button Content="{x:Static resources:Strings.ImportBackup}"
                                       AutomationProperties.AutomationId="Settings_ImportBackupButton"
                                       AutomationProperties.Name="{x:Static resources:Strings.ImportBackup}"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Command="{Binding ImportBackupCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════════
                     CARD 8: Nâng cao (Advanced)
                     ══════════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Section Header -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="{StaticResource MarginBottomMedium}">
                            <TextBlock Text="{x:Static resources:Strings.AdvancedSectionTitle}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="{x:Static resources:Strings.AdvancedSectionSubtitle}"
                                       Style="{StaticResource DescriptionTextStyle}" />
                        </StackPanel>

                        <!-- Row 1: Launch URI Template -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{x:Static resources:Strings.LaunchUriTemplateStatus}"
                                   Style="{StaticResource SettingLabelStyle}"
                                   Margin="{StaticResource MarginTight}" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding LaunchUriTemplateStatus}"
                                   Style="{StaticResource MonospaceTextStyle}"
                                   VerticalAlignment="Center" />

                        <!-- Divider -->
                        <Rectangle Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                   Height="1"
                                   Fill="{DynamicResource DividerStrokeColorDefaultBrush}"
                                   Margin="0,8" />

                        <!-- Row 2: Place Launcher URL Template -->
                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="{x:Static resources:Strings.PlaceLauncherUrlTemplateStatus}"
                                   Style="{StaticResource SettingLabelStyle}"
                                   Margin="{StaticResource MarginTight}" />
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="{Binding PlaceLauncherUrlTemplateStatus}"
                                   Style="{StaticResource MonospaceTextStyle}"
                                   VerticalAlignment="Center" />

                        <!-- Divider 2 -->
                        <Rectangle Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                   Height="1"
                                   Fill="{DynamicResource DividerStrokeColorDefaultBrush}"
                                   Margin="0,8" />

                        <!-- Row 3: UAT Live Trace Telemetry -->
                        <StackPanel Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="{StaticResource MarginTight}">
                            <TextBlock Text="{x:Static resources:Strings.EnableUatTelemetry}"
                                       Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock Text="{x:Static resources:Strings.EnableUatTelemetryDescription}"
                                       Style="{StaticResource DescriptionTextStyle}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Row="5" Grid.Column="1"
                                         AutomationProperties.AutomationId="Settings_UatTelemetryToggle"
                                         AutomationProperties.Name="{x:Static resources:Strings.EnableUatTelemetry}"
                                         IsChecked="{Binding EnableUatTelemetry, Mode=OneWay}"
                                         Command="{Binding EnableUatTelemetryToggledCommand}"
                                         CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}"
                                         VerticalAlignment="Center" />
                    </Grid>
                </Border>

            </StackPanel>
    </Grid>
</Page>
