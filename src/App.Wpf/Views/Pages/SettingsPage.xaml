<Page x:Class="RbxManager.App.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:RbxManager.App.Resources"
      Title="{x:Static resources:Strings.SettingsPageTitle}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource MarginLarge}" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{x:Static resources:Strings.SettingsPageTitle}"
                       FontSize="{StaticResource FontSizeTitle}"
                       FontWeight="SemiBold"
                       Margin="{StaticResource MarginMedium}" />

            <!-- Card 1: Appearance -->
            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Padding="{StaticResource PaddingMedium}"
                    Margin="{StaticResource MarginBase}">
                <StackPanel>
                    <TextBlock Text="{x:Static resources:Strings.AppearanceSectionTitle}"
                               FontSize="{StaticResource FontSizeSubtitle}"
                               FontWeight="SemiBold"
                               Margin="{StaticResource MarginTight}" />
                    <TextBlock Text="{x:Static resources:Strings.AppearanceSectionSubtitle}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="{StaticResource MarginMedium}" />

                    <!-- Language Setting -->
                    <TextBlock Text="{x:Static resources:Strings.LanguageLabel}"
                               FontWeight="Medium"
                               FontSize="{StaticResource FontSizeBody}"
                               Margin="{StaticResource MarginTight}" />
                    <ComboBox SelectedValuePath="Tag"
                              SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                              Margin="{StaticResource MarginBase}"
                              Width="280"
                              HorizontalAlignment="Left">
                        <ComboBoxItem Content="Tiếng Việt (vi-VN)" Tag="vi" />
                        <ComboBoxItem Content="English (en-US)" Tag="en" />
                    </ComboBox>

                    <!-- Theme Setting -->
                    <TextBlock Text="{x:Static resources:Strings.ThemeLabel}"
                               FontWeight="Medium"
                               FontSize="{StaticResource FontSizeBody}"
                               Margin="{StaticResource MarginTight}" />
                    <ComboBox SelectedValuePath="Tag"
                              SelectedValue="{Binding SelectedTheme, Mode=TwoWay}"
                              Margin="{StaticResource MarginTight}"
                              Width="280"
                              HorizontalAlignment="Left">
                        <ComboBoxItem Content="{x:Static resources:Strings.ThemeDark}" Tag="Dark" />
                        <ComboBoxItem Content="{x:Static resources:Strings.ThemeLight}" Tag="Light" />
                        <ComboBoxItem Content="{x:Static resources:Strings.ThemeSystem}" Tag="System" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Card 2: Launching -->
            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Padding="{StaticResource PaddingMedium}"
                    Margin="{StaticResource MarginBase}">
                <StackPanel>
                    <TextBlock Text="{x:Static resources:Strings.LaunchingSectionTitle}"
                               FontSize="{StaticResource FontSizeSubtitle}"
                               FontWeight="SemiBold"
                               Margin="{StaticResource MarginTight}" />
                    <TextBlock Text="{x:Static resources:Strings.LaunchingSectionSubtitle}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="{StaticResource MarginMedium}" />

                    <!-- Launch Delay Setting -->
                    <TextBlock Text="{x:Static resources:Strings.LaunchDelayLabel}"
                               FontWeight="Medium"
                               FontSize="{StaticResource FontSizeBody}"
                               Margin="{StaticResource MarginTight}" />
                    <TextBox Text="{Binding LaunchDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="280"
                             HorizontalAlignment="Left"
                             Margin="{StaticResource MarginTight}" />
                </StackPanel>
            </Border>

            <!-- Card 3: Auto-rejoin -->
            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Padding="{StaticResource PaddingMedium}"
                    Margin="{StaticResource MarginBase}">
                <StackPanel>
                    <TextBlock Text="{x:Static resources:Strings.AutoRejoinSectionTitle}"
                               FontSize="{StaticResource FontSizeSubtitle}"
                               FontWeight="SemiBold"
                               Margin="{StaticResource MarginTight}" />
                    <TextBlock Text="{x:Static resources:Strings.AutoRejoinSectionSubtitle}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="{StaticResource MarginMedium}" />

                    <!-- Rejoin Delay Setting -->
                    <TextBlock Text="{x:Static resources:Strings.RejoinDelayLabel}"
                               FontWeight="Medium"
                               FontSize="{StaticResource FontSizeBody}"
                               Margin="{StaticResource MarginTight}" />
                    <TextBox Text="{Binding RejoinDelaySeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="280"
                             HorizontalAlignment="Left"
                             Margin="{StaticResource MarginBase}" />

                    <!-- Rejoin Max Attempts Setting -->
                    <TextBlock Text="{x:Static resources:Strings.RejoinMaxAttemptsLabel}"
                               FontWeight="Medium"
                               FontSize="{StaticResource FontSizeBody}"
                               Margin="{StaticResource MarginTight}" />
                    <TextBox Text="{Binding RejoinMaxAttempts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="280"
                             HorizontalAlignment="Left"
                             Margin="{StaticResource MarginTight}" />
                </StackPanel>
            </Border>

            <!-- Card 4: Multi-Instance -->
            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Padding="{StaticResource PaddingMedium}"
                    Margin="{StaticResource MarginBase}">
                <StackPanel>
                    <TextBlock Text="{x:Static resources:Strings.MultiInstanceSectionTitle}"
                               FontSize="{StaticResource FontSizeSubtitle}"
                               FontWeight="SemiBold"
                               Margin="{StaticResource MarginTight}" />
                    <TextBlock Text="{x:Static resources:Strings.MultiInstanceSectionSubtitle}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="{StaticResource MarginMedium}" />

                    <CheckBox Content="{x:Static resources:Strings.MultiInstanceLabel}"
                              IsChecked="{Binding MultiInstanceEnabled, Mode=TwoWay}"
                              IsEnabled="{Binding IsMultiInstanceAvailable}"
                              Margin="{StaticResource MarginBase}" />

                    <!-- Risk text next to toggle -->
                    <Border Background="{DynamicResource StatusExpiredBackgroundBrush}"
                            BorderBrush="{DynamicResource StatusExpiredBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSmall}"
                            Padding="{StaticResource PaddingBase}"
                            Margin="{StaticResource MarginTight}">
                        <TextBlock Text="{x:Static resources:Strings.MultiInstanceNotAvailable}"
                                   Foreground="{DynamicResource StatusExpiredForegroundBrush}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Card: Security -->
            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Padding="{StaticResource PaddingMedium}"
                    Margin="{StaticResource MarginBase}">
                <StackPanel>
                    <TextBlock Text="{x:Static resources:Strings.SecuritySectionTitle}"
                               FontSize="{StaticResource FontSizeSubtitle}"
                               FontWeight="SemiBold"
                               Margin="{StaticResource MarginTight}" />
                    <TextBlock Text="{x:Static resources:Strings.SecuritySectionSubtitle}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="{StaticResource MarginMedium}" />

                    <CheckBox Content="{x:Static resources:Strings.EnableMasterPassword}"
                              IsChecked="{Binding IsMasterPasswordEnabled, Mode=OneWay}"
                              Command="{Binding MasterPasswordToggledCommand}"
                              CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}"
                              Margin="{StaticResource MarginTight}" />

                    <TextBlock Text="{x:Static resources:Strings.EnableMasterPasswordDescription}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="{StaticResource MarginTight}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Card: Performance & Optimization -->
            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Padding="{StaticResource PaddingMedium}"
                    Margin="{StaticResource MarginBase}">
                <StackPanel>
                    <TextBlock Text="{x:Static resources:Strings.ResourceOptimizationSectionTitle}"
                               FontSize="{StaticResource FontSizeSubtitle}"
                               FontWeight="SemiBold"
                               Margin="{StaticResource MarginTight}" />
                    <TextBlock Text="{x:Static resources:Strings.ResourceOptimizationSectionSubtitle}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="{StaticResource MarginMedium}" />

                    <CheckBox Content="{x:Static resources:Strings.ThrottleBackgroundRoblox}"
                              IsChecked="{Binding ThrottleBackgroundRoblox, Mode=OneWay}"
                              Command="{Binding ThrottleBackgroundRobloxToggledCommand}"
                              CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}"
                              Margin="{StaticResource MarginTight}" />

                    <TextBlock Text="{x:Static resources:Strings.ThrottleBackgroundRobloxDescription}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="{StaticResource MarginTight}"
                               TextWrapping="Wrap" />

                    <!-- Smart RAM Cleaner -->
                    <ui:ToggleSwitch Content="{x:Static resources:Strings.EnableRamCleaner}"
                                     IsChecked="{Binding EnableRamCleaner, Mode=OneWay}"
                                     Command="{Binding EnableRamCleanerToggledCommand}"
                                     CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}"
                                     Margin="{StaticResource MarginBase}" />

                    <TextBlock Text="{x:Static resources:Strings.EnableRamCleanerDescription}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="{StaticResource MarginTight}"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{x:Static resources:Strings.RamCleanerInterval}"
                               FontWeight="Medium"
                               FontSize="{StaticResource FontSizeBody}"
                               Margin="{StaticResource MarginBase}" />

                    <StackPanel Orientation="Horizontal" Margin="{StaticResource MarginTight}">
                        <Slider Width="240"
                                Minimum="5"
                                Maximum="120"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                Value="{Binding RamCleanerIntervalMinutes, Mode=TwoWay}"
                                IsEnabled="{Binding EnableRamCleaner}"
                                VerticalAlignment="Center" />
                        <TextBlock Text="{Binding RamCleanerIntervalDisplay}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource MarginTight}" />
                    </StackPanel>

                    <TextBlock Text="{x:Static resources:Strings.RamCleanerIntervalDescription}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="{StaticResource MarginTight}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Card: Backup & Restore -->
            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Padding="{StaticResource PaddingMedium}"
                    Margin="{StaticResource MarginBase}">
                <StackPanel>
                    <TextBlock Text="{x:Static resources:Strings.BackupSectionTitle}"
                               FontSize="{StaticResource FontSizeSubtitle}"
                               FontWeight="SemiBold"
                               Margin="{StaticResource MarginTight}" />
                    <TextBlock Text="{x:Static resources:Strings.BackupSectionSubtitle}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="{StaticResource MarginMedium}" />

                    <StackPanel Orientation="Horizontal" Margin="{StaticResource MarginTight}">
                        <ui:Button Content="{x:Static resources:Strings.ExportBackup}"
                                   Icon="{ui:SymbolIcon ArrowUpload24}"
                                   Margin="{StaticResource MarginTight}"
                                   Command="{Binding ExportBackupCommand}" />
                        <ui:Button Content="{x:Static resources:Strings.ImportBackup}"
                                   Icon="{ui:SymbolIcon ArrowDownload24}"
                                   Margin="{StaticResource MarginTight}"
                                   Command="{Binding ImportBackupCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 6: Advanced -->
            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Padding="{StaticResource PaddingMedium}"
                    Margin="{StaticResource MarginBase}">
                <StackPanel>
                    <TextBlock Text="{x:Static resources:Strings.AdvancedSectionTitle}"
                               FontSize="{StaticResource FontSizeSubtitle}"
                               FontWeight="SemiBold"
                               Margin="{StaticResource MarginTight}" />
                    <TextBlock Text="{x:Static resources:Strings.AdvancedSectionSubtitle}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="{StaticResource MarginMedium}" />

                    <TextBlock Text="{x:Static resources:Strings.LaunchUriTemplateStatus}"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource FontSizeBody}"
                               Margin="{StaticResource MarginTight}" />
                    <TextBlock Text="{Binding LaunchUriTemplateStatus}"
                               FontFamily="{StaticResource FontFamilyMonospace}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="{StaticResource MarginBase}" />

                    <TextBlock Text="{x:Static resources:Strings.PlaceLauncherUrlTemplateStatus}"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource FontSizeBody}"
                               Margin="{StaticResource MarginTight}" />
                    <TextBlock Text="{Binding PlaceLauncherUrlTemplateStatus}"
                               FontFamily="{StaticResource FontFamilyMonospace}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="{StaticResource MarginTight}" />
                </StackPanel>
            </Border>

            <!-- Save Action Button -->
            <ui:Button Appearance="Primary"
                       Content="{x:Static resources:Strings.Save}"
                       Command="{Binding SaveSettingsCommand}"
                       Width="140"
                       Margin="{StaticResource MarginMedium}"
                       HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</Page>
