<Page x:Class="RbxManager.App.Views.Pages.DiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:RbxManager.App.Resources"
      Title="{x:Static resources:Strings.NavDiagnostics}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>
    <Grid Margin="10,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Compact Two-Tier Controls Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource CommandBarCardStyle}" Padding="10,6" Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Tier 1: Title, Account Picker, Run & Copy Report -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Border Style="{StaticResource SectionIconBadgeStyle}">
                            <ui:SymbolIcon Symbol="Stethoscope24"
                                           FontSize="14"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{x:Static resources:Strings.DiagnosticsTitle}"
                                   Style="{StaticResource PageTitleStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Column="1" Style="{StaticResource ToolbarSeparatorStyle}" Margin="6,0" />

                    <TextBlock Grid.Column="2"
                               Text="{x:Static resources:Strings.AccountPickerLabel}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               Margin="0,0,6,0" />

                    <ComboBox Grid.Column="3"
                              ItemsSource="{Binding Accounts}"
                              AutomationProperties.AutomationId="Diagnostics_AccountsComboBox"
                              SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                              DisplayMemberPath="Alias"
                              Width="180"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0" />

                    <ui:Button Grid.Column="4"
                               Appearance="Primary"
                               AutomationProperties.AutomationId="Diagnostics_RunButton"
                               AutomationProperties.Name="{x:Static resources:Strings.RunDiagnostics}"
                               Content="{x:Static resources:Strings.RunDiagnostics}"
                               Icon="{ui:SymbolIcon Stethoscope24}"
                               Padding="10,5"
                               Command="{Binding RunDiagnosticsCommand}"
                               IsEnabled="{Binding IsNotRunning}"
                               Margin="0,0,6,0" />

                    <ui:Button Grid.Column="5"
                               Appearance="Secondary"
                               AutomationProperties.AutomationId="Diagnostics_CopyReportButton"
                               AutomationProperties.Name="{x:Static resources:Strings.CopyReport}"
                               Content="{x:Static resources:Strings.CopyReport}"
                               Icon="{ui:SymbolIcon Copy24}"
                               Padding="10,5"
                               Command="{Binding CopyReportCommand}"
                               IsEnabled="{Binding IsNotRunning}"
                               HorizontalAlignment="Left" />

                    <ui:ProgressRing Grid.Column="7"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                                     Width="18"
                                     Height="18"
                                     VerticalAlignment="Center" />
                </Grid>

                <!-- Tier 2: Potassium Scanner & Quick Launch Integration -->
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSmall}"
                            Padding="8,4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <TextBlock AutomationProperties.AutomationId="Diagnostics_PotassiumStatusText"
                                   Text="{Binding PotassiumStatusSummary}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Appearance="Secondary"
                                   AutomationProperties.AutomationId="Diagnostics_ScanPotassiumButton"
                                   AutomationProperties.Name="{x:Static resources:Strings.ScanPotassium}"
                                   Content="{x:Static resources:Strings.ScanPotassium}"
                                   Icon="{ui:SymbolIcon Search24}"
                                   Padding="10,5"
                                   Margin="0,0,6,0"
                                   Command="{Binding ScanPotassiumCommand}" />
                        <ui:Button Appearance="Secondary"
                                   AutomationProperties.AutomationId="Diagnostics_LaunchPotassiumButton"
                                   AutomationProperties.Name="{x:Static resources:Strings.LaunchPotassium}"
                                   Content="{x:Static resources:Strings.LaunchPotassium}"
                                   Icon="{ui:SymbolIcon Rocket24}"
                                   Padding="10,5"
                                   IsEnabled="{Binding IsPotassiumInstalled}"
                                   Command="{Binding LaunchPotassiumCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Report Output — Terminal-style Card -->
        <Border Grid.Row="1"
                Style="{StaticResource ElevatedContainerStyle}"
                Background="{DynamicResource TerminalBackgroundBrush}">
            <ui:TextBox AutomationProperties.AutomationId="Diagnostics_ReportTextBox"
                        Text="{Binding ReportText, Mode=OneWay}"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        FontFamily="{StaticResource FontFamilyMonospace}"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{DynamicResource TerminalForegroundBrush}"
                        Background="{DynamicResource TerminalBackgroundBrush}"
                        BorderThickness="0"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled" />
        </Border>
    </Grid>
</Page>
