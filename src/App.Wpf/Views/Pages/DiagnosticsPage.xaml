<Page x:Class="RbxManager.App.Views.Pages.DiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:RbxManager.App.Resources"
      Title="{x:Static resources:Strings.NavDiagnostics}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>
    <Grid Margin="{StaticResource MarginLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="{StaticResource MarginBottomMedium}">
            <TextBlock Text="{x:Static resources:Strings.DiagnosticsTitle}"
                       Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{x:Static resources:Strings.NavDiagnostics}"
                       Style="{StaticResource PageSubtitleStyle}"
                       Visibility="Collapsed" />
        </StackPanel>

        <!-- Controls Toolbar -->
        <Grid Grid.Row="1" Margin="{StaticResource MarginBottomMedium}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{x:Static resources:Strings.AccountPickerLabel}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="{StaticResource FontSizeBody}"
                       Margin="0,0,8,0" />

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Accounts}"
                      AutomationProperties.AutomationId="Diagnostics_AccountsComboBox"
                      SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                      DisplayMemberPath="Alias"
                      Width="200"
                      Margin="0,0,12,0" />

            <Border Grid.Column="2" Style="{StaticResource ToolbarSeparatorStyle}" />

            <ui:Button Grid.Column="3"
                       Appearance="Primary"
                       AutomationProperties.AutomationId="Diagnostics_RunButton"
                       Content="{x:Static resources:Strings.RunDiagnostics}"
                       Icon="{ui:SymbolIcon Stethoscope24}"
                       Command="{Binding RunDiagnosticsCommand}"
                       IsEnabled="{Binding IsNotRunning}"
                       Margin="0,0,8,0" />

            <ui:Button Grid.Column="4"
                       Appearance="Secondary"
                       AutomationProperties.AutomationId="Diagnostics_CopyReportButton"
                       Content="{x:Static resources:Strings.CopyReport}"
                       Icon="{ui:SymbolIcon Copy24}"
                       Command="{Binding CopyReportCommand}"
                       IsEnabled="{Binding IsNotRunning}"
                       HorizontalAlignment="Left"
                       Margin="0,0,12,0" />

            <ui:ProgressRing Grid.Column="5"
                             IsIndeterminate="True"
                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                             Width="24"
                             Height="24"
                             VerticalAlignment="Center" />
        </Grid>

        <!-- Report Output — Terminal-style Card -->
        <Border Grid.Row="2"
                Style="{StaticResource ElevatedContainerStyle}"
                Background="{DynamicResource TerminalBackgroundBrush}">
            <ui:TextBox AutomationProperties.AutomationId="Diagnostics_ReportTextBox"
                        Text="{Binding ReportText, Mode=OneWay}"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        FontFamily="{StaticResource FontFamilyMonospace}"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{DynamicResource TerminalForegroundBrush}"
                        Background="{DynamicResource TerminalBackgroundBrush}"
                        BorderThickness="0"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto" />
        </Border>
    </Grid>
</Page>
