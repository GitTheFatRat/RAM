<Page x:Class="RbxManager.App.Views.Pages.AccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:RbxManager.App.Resources"
      xmlns:viewModels="clr-namespace:RbxManager.App.ViewModels"
      d:DataContext="{d:DesignInstance viewModels:AccountsViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="{x:Static resources:Strings.AccountsPageTitle}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Header -->
        <TextBlock Grid.Row="0"
                   Text="{x:Static resources:Strings.AccountsPageTitle}"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <!-- Controls Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Search box -->
            <ui:TextBox Grid.Column="0"
                        PlaceholderText="{x:Static resources:Strings.SearchPlaceholder}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Icon="{ui:SymbolIcon Search24}"
                        MaxWidth="300"
                        HorizontalAlignment="Left" />

            <!-- Buttons -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="16,0,0,0">
                <ui:Button Content="{x:Static resources:Strings.AddViaLogin}"
                           Icon="{ui:SymbolIcon PersonAdd24}"
                           Appearance="Primary"
                           Margin="0,0,6,0"
                           Command="{Binding AddViaLoginCommand}" />
                <ui:Button Content="{x:Static resources:Strings.AddViaCookie}"
                           Icon="{ui:SymbolIcon Key24}"
                           Margin="0,0,6,0"
                           Command="{Binding AddAccountCommand}" />
                <ui:Button Content="{x:Static resources:Strings.Check}"
                           Icon="{ui:SymbolIcon CheckmarkCircle24}"
                           Margin="0,0,6,0"
                           Command="{Binding CheckAccountCommand}"
                           IsEnabled="{Binding IsAccountSelected}" />
                <ui:Button Content="{x:Static resources:Strings.CheckAll}"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Margin="0,0,6,0"
                           Command="{Binding CheckAllCommand}" />
                <ui:Button Content="{x:Static resources:Strings.Cancel}"
                           Icon="{ui:SymbolIcon Dismiss24}"
                           Margin="0,0,6,0"
                           Command="{Binding CancelCheckAllCommand}"
                           Visibility="{Binding IsCheckingAll, Converter={StaticResource BoolToVis}}" />
                <ui:Button Content="{x:Static resources:Strings.Launch}"
                           Icon="{ui:SymbolIcon Play24}"
                           Appearance="Success"
                           Margin="0,0,6,0"
                           Command="{Binding LaunchAccountCommand}"
                           IsEnabled="{Binding IsAccountSelected}" />
                <ui:Button Content="{x:Static resources:Strings.EditAccount}"
                           Icon="{ui:SymbolIcon Edit24}"
                           Margin="0,0,6,0"
                           Command="{Binding EditAccountCommand}"
                           IsEnabled="{Binding IsAccountSelected}" />
                <ui:Button Content="{x:Static resources:Strings.DeleteAccount}"
                           Icon="{ui:SymbolIcon Delete24}"
                           Appearance="Danger"
                           Command="{Binding DeleteAccountCommand}"
                           IsEnabled="{Binding IsAccountSelected}" />
            </StackPanel>
        </Grid>

        <!-- Progress Bar for Check All -->
        <Grid Grid.Row="2"
              Margin="0,0,0,12"
              Visibility="{Binding IsCheckingAll, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0"
                         IsIndeterminate="True"
                         Height="6"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0" />
            <TextBlock Grid.Column="1"
                       Text="{Binding CheckAllProgressText}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="3">
            <!-- Data Grid -->
            <ui:DataGrid ItemsSource="{Binding FilteredAccounts}"
                         SelectedItem="{Binding SelectedAccount}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         GridLinesVisibility="Horizontal">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static resources:Strings.ColumnAlias}"
                                        Binding="{Binding Alias}"
                                        Width="160" />
                    <DataGridTextColumn Header="{x:Static resources:Strings.ColumnUsername}"
                                        Binding="{Binding Username}"
                                        Width="160" />
                    <DataGridTemplateColumn Header="{x:Static resources:Strings.ColumnStatus}"
                                            Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:InfoBadge Severity="{Binding StatusSeverity}"
                                              Value="{Binding StatusText}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{x:Static resources:Strings.ColumnGroup}"
                                        Binding="{Binding Group}"
                                        Width="140" />
                    <DataGridTextColumn Header="{x:Static resources:Strings.ColumnLastChecked}"
                                        Binding="{Binding LastCheckedFormatted}"
                                        Width="170" />
                    <DataGridTextColumn Header="{x:Static resources:Strings.ColumnCreated}"
                                        Binding="{Binding CreatedFormatted}"
                                        Width="170" />
                </ui:DataGrid.Columns>
            </ui:DataGrid>

            <!-- Empty State Overlay -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BoolToVis}}">
                <ui:SymbolIcon Symbol="PersonQuestionMark24"
                               FontSize="48"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12" />
                <TextBlock Text="{x:Static resources:Strings.EmptyAccountsList}"
                           FontSize="16"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
