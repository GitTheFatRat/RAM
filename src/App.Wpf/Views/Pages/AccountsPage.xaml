<Page x:Class="RbxManager.App.Views.Pages.AccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:RbxManager.App.Resources"
      xmlns:viewModels="clr-namespace:RbxManager.App.ViewModels"
      d:DataContext="{d:DesignInstance viewModels:AccountsViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      PreviewKeyDown="OnPagePreviewKeyDown"
      Title="{x:Static resources:Strings.AccountsPageTitle}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="{StaticResource MarginLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Header -->
        <TextBlock Grid.Row="0"
                   Text="{x:Static resources:Strings.AccountsPageTitle}"
                   FontSize="{StaticResource FontSizeTitle}"
                   FontWeight="SemiBold"
                   Margin="{StaticResource MarginMedium}" />

        <!-- Controls Bar 1: Search + Primary & More Toolbar -->
        <Grid Grid.Row="1" Margin="{StaticResource MarginBase}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Search box -->
            <ui:TextBox x:Name="SearchBox"
                        Grid.Column="0"
                        PlaceholderText="{x:Static resources:Strings.SearchPlaceholder}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Icon="{ui:SymbolIcon Search24}"
                        MaxWidth="320"
                        HorizontalAlignment="Left" />

            <!-- Toolbar Actions -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="{StaticResource MarginMedium}">
                <!-- Primary Action: Launch (Accent) -->
                <ui:Button Content="{x:Static resources:Strings.Launch}"
                           Icon="{ui:SymbolIcon Play24}"
                           Appearance="Primary"
                           Margin="{StaticResource MarginTight}"
                           Command="{Binding LaunchAccountCommand}"
                           IsEnabled="{Binding IsAccountSelected}" />

                <!-- Add Split Button (Add via Login default + Options) -->
                <Grid Margin="{StaticResource MarginTight}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0"
                               Content="{x:Static resources:Strings.AddViaLogin}"
                               Icon="{ui:SymbolIcon PersonAdd24}"
                               Command="{Binding AddViaLoginCommand}"
                               ToolTip="Ctrl+N" />
                    <ui:Button Grid.Column="1"
                               Icon="{ui:SymbolIcon ChevronDown24}"
                               Click="OnAddSplitMenuClick"
                               AutomationProperties.Name="{x:Static resources:Strings.AddAccountDialogTitle}">
                        <ui:Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static resources:Strings.AddViaLogin}"
                                          Command="{Binding AddViaLoginCommand}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="PersonAdd24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static resources:Strings.AddViaCookie}"
                                          Command="{Binding AddAccountCommand}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Key24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                </Grid>

                <!-- More Actions Menu -->
                <ui:Button Content="{x:Static resources:Strings.MoreActions}"
                           Icon="{ui:SymbolIcon MoreHorizontal24}"
                           Margin="{StaticResource MarginTight}"
                           Click="OnMoreButtonClick">
                    <ui:Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static resources:Strings.Check}"
                                      Command="{Binding CheckAccountCommand}"
                                      IsEnabled="{Binding IsAccountSelected}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{x:Static resources:Strings.CheckAll}"
                                      Command="{Binding CheckAllCommand}"
                                      IsEnabled="{Binding IsNotBusy}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="ArrowSync24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{x:Static resources:Strings.EditAccount}"
                                      Command="{Binding EditAccountCommand}"
                                      IsEnabled="{Binding IsAccountSelected}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Edit24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{x:Static resources:Strings.DeleteAccount}"
                                      Command="{Binding DeleteAccountCommand}"
                                      IsEnabled="{Binding IsAccountSelected}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Delete24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{x:Static resources:Strings.RenameGroup}"
                                      Command="{Binding RenameGroupCommand}"
                                      IsEnabled="{Binding IsRenameGroupVisible}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Rename24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{x:Static resources:Strings.ExportBackup}"
                                      Command="{Binding ExportBackupCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="ArrowUpload24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{x:Static resources:Strings.ImportBackup}"
                                      Command="{Binding ImportBackupCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="ArrowDownload24" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>

                <!-- Cancel button during CheckAll -->
                <ui:Button Content="{x:Static resources:Strings.Cancel}"
                           Icon="{ui:SymbolIcon Dismiss24}"
                           Margin="{StaticResource MarginTight}"
                           Command="{Binding CancelCheckAllCommand}"
                           Visibility="{Binding IsCheckingAll, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>

        <!-- Controls Bar 2: Group Filter Chips + Bulk Actions -->
        <Grid Grid.Row="2" Margin="{StaticResource MarginBase}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Group Filter Chips -->
            <ScrollViewer Grid.Column="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Button Content="{Binding}"
                                           Margin="{StaticResource MarginTight}"
                                           Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ui:Button Content="{x:Static resources:Strings.RenameGroup}"
                               Icon="{ui:SymbolIcon Edit24}"
                               Margin="{StaticResource MarginTight}"
                               Command="{Binding RenameGroupCommand}"
                               Visibility="{Binding IsRenameGroupVisible, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Bulk Launch Actions -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="{StaticResource MarginMedium}">
                <ui:Button Content="{x:Static resources:Strings.LaunchSelected}"
                           Icon="{ui:SymbolIcon PlayCircle24}"
                           Margin="{StaticResource MarginTight}"
                           Command="{Binding LaunchSelectedAccountsCommand}" />
                <ui:Button Content="{x:Static resources:Strings.LaunchGroup}"
                           Icon="{ui:SymbolIcon PlayCircle24}"
                           Margin="{StaticResource MarginTight}"
                           Command="{Binding LaunchGroupAccountsCommand}"
                           Visibility="{Binding IsLaunchGroupVisible, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>

        <!-- Progress Indicator for Check All -->
        <Grid Grid.Row="3"
              Margin="{StaticResource MarginBase}"
              Visibility="{Binding IsCheckingAll, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0"
                         IsIndeterminate="True"
                         Height="4"
                         VerticalAlignment="Center"
                         Margin="{StaticResource MarginBase}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding CheckAllProgressText}"
                       FontSize="{StaticResource FontSizeCaption}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- Main Content Area: High-Density Virtualized DataGrid -->
        <Grid Grid.Row="4">
            <ui:DataGrid x:Name="AccountsDataGrid"
                         ItemsSource="{Binding FilteredAccounts}"
                         SelectedItem="{Binding SelectedAccount}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         GridLinesVisibility="None"
                         RowHeight="36"
                         Sorting="OnDataGridSorting"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.CanContentScroll="True">
                <ui:DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="{x:Static resources:Strings.Launch}"
                                              Command="{Binding DataContext.LaunchAccountCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Play24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{x:Static resources:Strings.Check}"
                                              Command="{Binding DataContext.CheckAccountCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="CheckmarkCircle24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{x:Static resources:Strings.EditAccount}"
                                              Command="{Binding DataContext.EditAccountCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Edit24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{x:Static resources:Strings.DeleteAccount}"
                                              Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Delete24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="{x:Static resources:Strings.CopyAlias}"
                                              Command="{Binding DataContext.CopyAliasCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Copy24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ui:DataGrid.RowStyle>

                <ui:DataGrid.Columns>
                    <!-- Checkbox Selection Column -->
                    <DataGridTemplateColumn Width="40" CanUserResize="False" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Alias Column -->
                    <DataGridTextColumn Header="{x:Static resources:Strings.ColumnAlias}"
                                        Binding="{Binding Alias}"
                                        SortMemberPath="Alias"
                                        Width="160" />

                    <!-- Group Column -->
                    <DataGridTextColumn Header="{x:Static resources:Strings.ColumnGroup}"
                                        Binding="{Binding Group}"
                                        SortMemberPath="Group"
                                        Width="130" />

                    <!-- Username Column -->
                    <DataGridTextColumn Header="{x:Static resources:Strings.ColumnUsername}"
                                        Binding="{Binding Username}"
                                        SortMemberPath="Username"
                                        Width="150" />

                    <!-- Status Chip Column (Glyph + Text + Token-based Contrast) -->
                    <DataGridTemplateColumn Header="{x:Static resources:Strings.ColumnStatus}"
                                            SortMemberPath="Status"
                                            Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="{StaticResource RadiusSmall}"
                                        Padding="8,3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderThickness" Value="1" />
                                            <!-- Default Unknown -->
                                            <Setter Property="Background" Value="{DynamicResource StatusUnknownBackgroundBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource StatusUnknownBorderBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Valid">
                                                    <Setter Property="Background" Value="{DynamicResource StatusValidBackgroundBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource StatusValidBorderBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Expired">
                                                    <Setter Property="Background" Value="{DynamicResource StatusExpiredBackgroundBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource StatusExpiredBorderBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                                    <Setter Property="Background" Value="{DynamicResource StatusErrorBackgroundBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBorderBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="{Binding StatusGlyph}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       Margin="{StaticResource MarginTight}">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Foreground" Value="{DynamicResource StatusUnknownForegroundBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Valid">
                                                            <Setter Property="Foreground" Value="{DynamicResource StatusValidForegroundBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Expired">
                                                            <Setter Property="Foreground" Value="{DynamicResource StatusExpiredForegroundBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Error">
                                                            <Setter Property="Foreground" Value="{DynamicResource StatusErrorForegroundBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource StatusUnknownForegroundBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Valid">
                                                            <Setter Property="Foreground" Value="{DynamicResource StatusValidForegroundBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Expired">
                                                            <Setter Property="Foreground" Value="{DynamicResource StatusExpiredForegroundBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Error">
                                                            <Setter Property="Foreground" Value="{DynamicResource StatusErrorForegroundBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Last Checked Column (Relative time + Tooltip full timestamp) -->
                    <DataGridTemplateColumn Header="{x:Static resources:Strings.ColumnLastChecked}"
                                            SortMemberPath="LastChecked"
                                            Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LastCheckedRelative}"
                                           ToolTip="{Binding LastCheckedTooltip}"
                                           VerticalAlignment="Center"
                                           FontSize="{StaticResource FontSizeBody}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Created Column -->
                    <DataGridTextColumn Header="{x:Static resources:Strings.ColumnCreated}"
                                        Binding="{Binding CreatedFormatted}"
                                        SortMemberPath="Created"
                                        Width="160" />
                </ui:DataGrid.Columns>
            </ui:DataGrid>

            <!-- Empty State 1: No Accounts in Vault -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsNoAccounts, Converter={StaticResource BoolToVis}}">
                <ui:SymbolIcon Symbol="PersonQuestionMark24"
                               FontSize="48"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="{StaticResource MarginMedium}" />
                <TextBlock Text="{x:Static resources:Strings.EmptyAccountsList}"
                           FontSize="{StaticResource FontSizeSubtitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="{StaticResource MarginTight}" />
                <TextBlock Text="{x:Static resources:Strings.EmptyAccountsHint}"
                           FontSize="{StaticResource FontSizeBody}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="{StaticResource MarginMedium}" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="{StaticResource MarginBase}">
                    <ui:Button Content="{x:Static resources:Strings.AddViaLogin}"
                               Icon="{ui:SymbolIcon PersonAdd24}"
                               Appearance="Primary"
                               Margin="{StaticResource MarginTight}"
                               Command="{Binding AddViaLoginCommand}" />
                    <ui:Button Content="{x:Static resources:Strings.AddViaCookie}"
                               Icon="{ui:SymbolIcon Key24}"
                               Margin="{StaticResource MarginTight}"
                               Command="{Binding AddAccountCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Empty State 2: No Search Results Found -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsNoSearchResults, Converter={StaticResource BoolToVis}}">
                <ui:SymbolIcon Symbol="Search24"
                               FontSize="48"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="{StaticResource MarginMedium}" />
                <TextBlock Text="{x:Static resources:Strings.NoSearchResults}"
                           FontSize="{StaticResource FontSizeSubtitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="{StaticResource MarginTight}" />
                <TextBlock Text="{x:Static resources:Strings.NoSearchResultsHint}"
                           FontSize="{StaticResource FontSizeBody}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="{StaticResource MarginMedium}" />
                <ui:Button Content="{x:Static resources:Strings.ClearSearch}"
                           Icon="{ui:SymbolIcon Dismiss24}"
                           HorizontalAlignment="Center"
                           Margin="{StaticResource MarginBase}"
                           Command="{Binding ClearSearchCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
