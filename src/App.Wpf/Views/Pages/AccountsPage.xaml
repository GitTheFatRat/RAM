<Page x:Class="RbxManager.App.Views.Pages.AccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:RbxManager.App.Resources"
      xmlns:viewModels="clr-namespace:RbxManager.App.ViewModels"
      d:DataContext="{d:DesignInstance viewModels:AccountsViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="{x:Static resources:Strings.AccountsPageTitle}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Header -->
        <TextBlock Grid.Row="0"
                   Text="{x:Static resources:Strings.AccountsPageTitle}"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <!-- Controls Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Search box -->
            <ui:TextBox Grid.Column="0"
                        PlaceholderText="{x:Static resources:Strings.SearchPlaceholder}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Icon="{ui:SymbolIcon Search24}"
                        MaxWidth="400"
                        HorizontalAlignment="Left" />

            <!-- Buttons -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="16,0,0,0">
                <ui:Button Content="{x:Static resources:Strings.AddAccount}"
                           Icon="{ui:SymbolIcon Add24}"
                           Appearance="Primary"
                           Margin="0,0,8,0"
                           Command="{Binding AddAccountCommand}" />
                <ui:Button Content="{x:Static resources:Strings.EditAccount}"
                           Icon="{ui:SymbolIcon Edit24}"
                           Margin="0,0,8,0"
                           Command="{Binding EditAccountCommand}"
                           IsEnabled="{Binding IsAccountSelected}" />
                <ui:Button Content="{x:Static resources:Strings.DeleteAccount}"
                           Icon="{ui:SymbolIcon Delete24}"
                           Appearance="Danger"
                           Command="{Binding DeleteAccountCommand}"
                           IsEnabled="{Binding IsAccountSelected}" />
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <!-- Data Grid -->
            <ui:DataGrid ItemsSource="{Binding FilteredAccounts}"
                         SelectedItem="{Binding SelectedAccount}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         GridLinesVisibility="Horizontal">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static resources:Strings.ColumnAlias}"
                                        Binding="{Binding Alias}"
                                        Width="*" />
                    <DataGridTextColumn Header="{x:Static resources:Strings.ColumnGroup}"
                                        Binding="{Binding Group}"
                                        Width="200" />
                    <DataGridTextColumn Header="{x:Static resources:Strings.ColumnCreated}"
                                        Binding="{Binding CreatedFormatted}"
                                        Width="220" />
                </ui:DataGrid.Columns>
            </ui:DataGrid>

            <!-- Empty State Overlay -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BoolToVis}}">
                <ui:SymbolIcon Symbol="PersonQuestionMark24"
                               FontSize="48"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12" />
                <TextBlock Text="{x:Static resources:Strings.EmptyAccountsList}"
                           FontSize="16"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
