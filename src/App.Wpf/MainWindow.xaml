<ui:FluentWindow x:Class="RbxManager.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:RbxManager.App.Views.Pages"
                 xmlns:resources="clr-namespace:RbxManager.App.Resources"
                 Title="{x:Static resources:Strings.AppTitle}"
                 Height="650"
                 Width="1000"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{x:Static resources:Strings.AppTitle}" />

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           PaneDisplayMode="Left">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{x:Static resources:Strings.NavAccounts}"
                                       Icon="{ui:SymbolIcon People24}"
                                       TargetPageType="{x:Type pages:AccountsPage}" />
                <ui:NavigationViewItem Content="{x:Static resources:Strings.NavSettings}"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
