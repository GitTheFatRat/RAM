<ui:FluentWindow x:Class="RbxManager.App.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:pages="clr-namespace:RbxManager.App.Views.Pages"
                  xmlns:controls="clr-namespace:RbxManager.App.Views.Controls"
                  xmlns:resources="clr-namespace:RbxManager.App.Resources"
                  Title="{x:Static resources:Strings.AppTitle}"
                  Height="760"
                  Width="1200"
                  MinWidth="960"
                  MinHeight="640"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica"
                  WindowCornerPreference="Round"
                  Icon="pack://application:,,,/RbxManager.App;component/Assets/app.ico"
                  WindowStartupLocation="CenterScreen"
                  Background="{DynamicResource ApplicationBackgroundBrush}"
                  TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                  PreviewKeyDown="OnMainWindowPreviewKeyDown">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Height="28"
                     AutomationProperties.AutomationId="MainTitleBar"
                     Title="{x:Static resources:Strings.AppTitle}"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     Icon="{ui:ImageIcon 'pack://application:,,,/RbxManager.App;component/Assets/app.ico'}" />

        <Grid Grid.Row="1">
            <ui:NavigationView x:Name="RootNavigation"
                               AutomationProperties.AutomationId="RootNavigation"
                               PaneDisplayMode="Top"
                               OpenPaneLength="48"
                               CompactPaneLength="48"
                               IsBackButtonVisible="Collapsed"
                               IsPaneToggleVisible="False"
                               Transition="FadeInWithSlide"
                               Margin="0">
                <ui:NavigationView.MenuItems>
                    <controls:NavViewItem Content="{x:Static resources:Strings.NavAccounts}"
                                          AutomationProperties.AutomationId="NavItem_Accounts"
                                          Icon="{ui:SymbolIcon People24}"
                                          TargetPageType="{x:Type pages:AccountsPage}" />
                    <controls:NavViewItem Content="{x:Static resources:Strings.NavServers}"
                                          AutomationProperties.AutomationId="NavItem_Servers"
                                          Icon="{ui:SymbolIcon Server24}"
                                          TargetPageType="{x:Type pages:ServersPage}" />
                    <controls:NavViewItem Content="{x:Static resources:Strings.NavRunning}"
                                          AutomationProperties.AutomationId="NavItem_Running"
                                          Icon="{ui:SymbolIcon Play24}"
                                          TargetPageType="{x:Type pages:RunningPage}" />
                    <controls:NavViewItem Content="{x:Static resources:Strings.NavDiagnostics}"
                                          AutomationProperties.AutomationId="NavItem_Diagnostics"
                                          Icon="{ui:SymbolIcon Stethoscope24}"
                                          TargetPageType="{x:Type pages:DiagnosticsPage}" />
                    <controls:NavViewItem Content="{x:Static resources:Strings.NavSettings}"
                                          AutomationProperties.AutomationId="NavItem_Settings"
                                          Icon="{ui:SymbolIcon Settings24}"
                                          TargetPageType="{x:Type pages:SettingsPage}" />
                </ui:NavigationView.MenuItems>
            </ui:NavigationView>

            <!-- Status Badges in the 48px Top Header Bar -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Height="48"
                        Margin="0,0,12,0"
                        IsHitTestVisible="False">
                <Border Background="{DynamicResource StatusRunningBackgroundBrush}"
                        BorderBrush="{DynamicResource StatusRunningBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPill}"
                        Padding="8,3"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding ViewModel.IsMultiInstanceEnabled, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="WindowMultiple20"
                                       FontSize="12"
                                       Margin="0,0,4,0"
                                       Foreground="{DynamicResource StatusRunningForegroundBrush}" />
                        <TextBlock Text="{x:Static resources:Strings.MultiInstanceSectionTitle}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource StatusRunningForegroundBrush}" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource StatusValidBackgroundBrush}"
                        BorderBrush="{DynamicResource StatusValidBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPill}"
                        Padding="8,3"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6"
                                 Height="6"
                                 Margin="0,0,4,0"
                                 Fill="{DynamicResource StatusValidForegroundBrush}" />
                        <TextBlock Text="{x:Static resources:Strings.StatusValid}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource StatusValidForegroundBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <ui:ContentDialogHost x:Name="RootContentDialogHost"
                              Grid.Row="1" />

        <ui:SnackbarPresenter x:Name="RootSnackbarPresenter"
                              Grid.Row="1" />
    </Grid>
</ui:FluentWindow>
