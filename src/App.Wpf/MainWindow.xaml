<ui:FluentWindow x:Class="RbxManager.App.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:pages="clr-namespace:RbxManager.App.Views.Pages"
                  xmlns:controls="clr-namespace:RbxManager.App.Views.Controls"
                  xmlns:resources="clr-namespace:RbxManager.App.Resources"
                  Title="{x:Static resources:Strings.AppTitle}"
                  Height="700"
                  Width="1100"
                  MinWidth="960"
                  MinHeight="600"
                  Icon="Assets/app.ico"
                  WindowStartupLocation="CenterScreen"
                  Background="{DynamicResource ApplicationBackgroundBrush}"
                  TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                  PreviewKeyDown="OnMainWindowPreviewKeyDown">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     AutomationProperties.AutomationId="MainTitleBar"
                     Title="{x:Static resources:Strings.AppTitle}"
                     Icon="{ui:ImageIcon 'pack://application:,,,/Assets/app.ico'}" />

        <ui:NavigationView x:Name="RootNavigation"
                           AutomationProperties.AutomationId="RootNavigation"
                           Grid.Row="1"
                           PaneDisplayMode="Left">
            <ui:NavigationView.MenuItems>
                <controls:NavViewItem Content="{x:Static resources:Strings.NavAccounts}"
                                      AutomationProperties.AutomationId="NavItem_Accounts"
                                      Icon="{ui:SymbolIcon People24}"
                                      TargetPageType="{x:Type pages:AccountsPage}" />
                <controls:NavViewItem Content="{x:Static resources:Strings.NavServers}"
                                      AutomationProperties.AutomationId="NavItem_Servers"
                                      Icon="{ui:SymbolIcon Server24}"
                                      TargetPageType="{x:Type pages:ServersPage}" />
                <controls:NavViewItem Content="{x:Static resources:Strings.NavRunning}"
                                      AutomationProperties.AutomationId="NavItem_Running"
                                      Icon="{ui:SymbolIcon Play24}"
                                      TargetPageType="{x:Type pages:RunningPage}" />
                <controls:NavViewItem Content="{x:Static resources:Strings.NavDiagnostics}"
                                      AutomationProperties.AutomationId="NavItem_Diagnostics"
                                      Icon="{ui:SymbolIcon Stethoscope24}"
                                      TargetPageType="{x:Type pages:DiagnosticsPage}" />
                <controls:NavViewItem Content="{x:Static resources:Strings.NavSettings}"
                                      AutomationProperties.AutomationId="NavItem_Settings"
                                      Icon="{ui:SymbolIcon Settings24}"
                                      TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>

        <ui:ContentDialogHost x:Name="RootContentDialogHost"
                              Grid.Row="1" />

        <ui:SnackbarPresenter x:Name="RootSnackbarPresenter"
                              Grid.Row="1" />
    </Grid>
</ui:FluentWindow>
