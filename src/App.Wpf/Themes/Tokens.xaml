<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Spacing Scale (8px grid, 4px tight) -->
    <sys:Double x:Key="SpacingTight">4</sys:Double>
    <sys:Double x:Key="SpacingBase">8</sys:Double>
    <sys:Double x:Key="SpacingMedium">16</sys:Double>
    <sys:Double x:Key="SpacingLarge">24</sys:Double>
    <sys:Double x:Key="SpacingXLarge">32</sys:Double>

    <Thickness x:Key="PaddingTight">4</Thickness>
    <Thickness x:Key="PaddingBase">8</Thickness>
    <Thickness x:Key="PaddingMedium">16</Thickness>
    <Thickness x:Key="PaddingLarge">24</Thickness>
    <Thickness x:Key="MarginTight">4</Thickness>
    <Thickness x:Key="MarginBase">8</Thickness>
    <Thickness x:Key="MarginMedium">16</Thickness>
    <Thickness x:Key="MarginLarge">24</Thickness>

    <!-- Corner Radii -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>

    <!-- Typography Scale: 12 / 14 / 16 / 20 / 28 -->
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">16</sys:Double>
    <sys:Double x:Key="FontSizeTitle">20</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">28</sys:Double>

    <FontFamily x:Key="FontFamilyPrimary">Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="FontFamilyMonospace">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <!-- Status Colors (Dark Palette: Default) -->
    <Color x:Key="StatusValidForegroundDarkColor">#81C784</Color>
    <Color x:Key="StatusValidBackgroundDarkColor">#142918</Color>
    <Color x:Key="StatusValidBorderDarkColor">#2E7D32</Color>

    <Color x:Key="StatusExpiredForegroundDarkColor">#FFB74D</Color>
    <Color x:Key="StatusExpiredBackgroundDarkColor">#2D1E0C</Color>
    <Color x:Key="StatusExpiredBorderDarkColor">#F57C00</Color>

    <Color x:Key="StatusErrorForegroundDarkColor">#E57373</Color>
    <Color x:Key="StatusErrorBackgroundDarkColor">#2C1314</Color>
    <Color x:Key="StatusErrorBorderDarkColor">#D32F2F</Color>

    <Color x:Key="StatusUnknownForegroundDarkColor">#CFD8DC</Color>
    <Color x:Key="StatusUnknownBackgroundDarkColor">#1E252B</Color>
    <Color x:Key="StatusUnknownBorderDarkColor">#546E7A</Color>

    <Color x:Key="StatusRunningForegroundDarkColor">#64B5F6</Color>
    <Color x:Key="StatusRunningBackgroundDarkColor">#0D233A</Color>
    <Color x:Key="StatusRunningBorderDarkColor">#1976D2</Color>

    <!-- Status Colors (Light Palette) -->
    <Color x:Key="StatusValidForegroundLightColor">#1B5E20</Color>
    <Color x:Key="StatusValidBackgroundLightColor">#E8F5E9</Color>
    <Color x:Key="StatusValidBorderLightColor">#A5D6A7</Color>

    <Color x:Key="StatusExpiredForegroundLightColor">#993D00</Color>
    <Color x:Key="StatusExpiredBackgroundLightColor">#FFF3E0</Color>
    <Color x:Key="StatusExpiredBorderLightColor">#FFCC80</Color>

    <Color x:Key="StatusErrorForegroundLightColor">#B71C1C</Color>
    <Color x:Key="StatusErrorBackgroundLightColor">#FFEBEE</Color>
    <Color x:Key="StatusErrorBorderLightColor">#EF9A9A</Color>

    <Color x:Key="StatusUnknownForegroundLightColor">#37474F</Color>
    <Color x:Key="StatusUnknownBackgroundLightColor">#ECEFF1</Color>
    <Color x:Key="StatusUnknownBorderLightColor">#B0BEC5</Color>

    <Color x:Key="StatusRunningForegroundLightColor">#0D47A1</Color>
    <Color x:Key="StatusRunningBackgroundLightColor">#E3F2FD</Color>
    <Color x:Key="StatusRunningBorderLightColor">#90CAF9</Color>

    <!-- Active Dynamic Brushes (Default to Dark) -->
    <SolidColorBrush x:Key="StatusValidForegroundBrush" Color="{StaticResource StatusValidForegroundDarkColor}" />
    <SolidColorBrush x:Key="StatusValidBackgroundBrush" Color="{StaticResource StatusValidBackgroundDarkColor}" />
    <SolidColorBrush x:Key="StatusValidBorderBrush" Color="{StaticResource StatusValidBorderDarkColor}" />

    <SolidColorBrush x:Key="StatusExpiredForegroundBrush" Color="{StaticResource StatusExpiredForegroundDarkColor}" />
    <SolidColorBrush x:Key="StatusExpiredBackgroundBrush" Color="{StaticResource StatusExpiredBackgroundDarkColor}" />
    <SolidColorBrush x:Key="StatusExpiredBorderBrush" Color="{StaticResource StatusExpiredBorderDarkColor}" />

    <SolidColorBrush x:Key="StatusErrorForegroundBrush" Color="{StaticResource StatusErrorForegroundDarkColor}" />
    <SolidColorBrush x:Key="StatusErrorBackgroundBrush" Color="{StaticResource StatusErrorBackgroundDarkColor}" />
    <SolidColorBrush x:Key="StatusErrorBorderBrush" Color="{StaticResource StatusErrorBorderDarkColor}" />

    <SolidColorBrush x:Key="StatusUnknownForegroundBrush" Color="{StaticResource StatusUnknownForegroundDarkColor}" />
    <SolidColorBrush x:Key="StatusUnknownBackgroundBrush" Color="{StaticResource StatusUnknownBackgroundDarkColor}" />
    <SolidColorBrush x:Key="StatusUnknownBorderBrush" Color="{StaticResource StatusUnknownBorderDarkColor}" />

    <SolidColorBrush x:Key="StatusRunningForegroundBrush" Color="{StaticResource StatusRunningForegroundDarkColor}" />
    <SolidColorBrush x:Key="StatusRunningBackgroundBrush" Color="{StaticResource StatusRunningBackgroundDarkColor}" />
    <SolidColorBrush x:Key="StatusRunningBorderBrush" Color="{StaticResource StatusRunningBorderDarkColor}" />

</ResourceDictionary>
