<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Spacing Scale (8px grid, 4px tight) -->
    <sys:Double x:Key="SpacingTight">4</sys:Double>
    <sys:Double x:Key="SpacingBase">8</sys:Double>
    <sys:Double x:Key="SpacingMedium">16</sys:Double>
    <sys:Double x:Key="SpacingLarge">24</sys:Double>
    <sys:Double x:Key="SpacingXLarge">32</sys:Double>

    <Thickness x:Key="PaddingTight">4</Thickness>
    <Thickness x:Key="PaddingBase">8</Thickness>
    <Thickness x:Key="PaddingMedium">16</Thickness>
    <Thickness x:Key="PaddingLarge">24</Thickness>
    <Thickness x:Key="MarginTight">4</Thickness>
    <Thickness x:Key="MarginBase">8</Thickness>
    <Thickness x:Key="MarginMedium">16</Thickness>
    <Thickness x:Key="MarginBottomMedium">0,0,0,16</Thickness>
    <Thickness x:Key="MarginLarge">24</Thickness>

    <!-- Corner Radii -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>

    <!-- Typography Scale: 12 / 14 / 16 / 20 / 28 -->
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">16</sys:Double>
    <sys:Double x:Key="FontSizeTitle">20</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">28</sys:Double>

    <FontFamily x:Key="FontFamilyPrimary">Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="FontFamilyMonospace">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <!-- Theme Contrast Colors (Dark Palette: Default) -->
    <Color x:Key="ApplicationBackgroundDarkColor">#111111</Color>
    <Color x:Key="CardBackgroundDarkColor">#2D2D2D</Color>
    <Color x:Key="ControlFillColorDefaultDarkColor">#2D2D2D</Color>
    <Color x:Key="ControlFillColorSecondaryDarkColor">#363636</Color>
    <Color x:Key="ControlFillColorTertiaryDarkColor">#444444</Color>
    <Color x:Key="TextFillColorPrimaryDarkColor">#FFFFFF</Color>
    <Color x:Key="TextFillColorSecondaryDarkColor">#CCCCCC</Color>
    <Color x:Key="DataGridRowAlternatingDarkColor">#222222</Color>
    <Color x:Key="DataGridHeaderBorderDarkColor">#383838</Color>
    <Color x:Key="DividerStrokeColorDefaultDarkColor">#383838</Color>

    <!-- Status Colors (Dark Palette: High Contrast) -->
    <Color x:Key="StatusValidForegroundDarkColor">#FFFFFF</Color>
    <Color x:Key="StatusValidBackgroundDarkColor">#1B5E20</Color>
    <Color x:Key="StatusValidBorderDarkColor">#4CAF50</Color>

    <Color x:Key="StatusExpiredForegroundDarkColor">#FFFFFF</Color>
    <Color x:Key="StatusExpiredBackgroundDarkColor">#B71C1C</Color>
    <Color x:Key="StatusExpiredBorderDarkColor">#EF5350</Color>

    <Color x:Key="StatusErrorForegroundDarkColor">#FFFFFF</Color>
    <Color x:Key="StatusErrorBackgroundDarkColor">#B71C1C</Color>
    <Color x:Key="StatusErrorBorderDarkColor">#EF5350</Color>

    <Color x:Key="StatusUnknownForegroundDarkColor">#FFFFFF</Color>
    <Color x:Key="StatusUnknownBackgroundDarkColor">#37474F</Color>
    <Color x:Key="StatusUnknownBorderDarkColor">#78909C</Color>

    <Color x:Key="StatusRunningForegroundDarkColor">#FFFFFF</Color>
    <Color x:Key="StatusRunningBackgroundDarkColor">#0D47A1</Color>
    <Color x:Key="StatusRunningBorderDarkColor">#42A5F5</Color>

    <!-- Theme Contrast Colors (Light Palette) -->
    <Color x:Key="ApplicationBackgroundLightColor">#F4F4F4</Color>
    <Color x:Key="CardBackgroundLightColor">#FFFFFF</Color>
    <Color x:Key="ControlFillColorDefaultLightColor">#FFFFFF</Color>
    <Color x:Key="ControlFillColorSecondaryLightColor">#E8E8E8</Color>
    <Color x:Key="ControlFillColorTertiaryLightColor">#DCDCDC</Color>
    <Color x:Key="TextFillColorPrimaryLightColor">#161616</Color>
    <Color x:Key="TextFillColorSecondaryLightColor">#5C5C5C</Color>
    <Color x:Key="DataGridRowAlternatingLightColor">#FAFAFA</Color>
    <Color x:Key="DataGridHeaderBorderLightColor">#D0D0D0</Color>
    <Color x:Key="DividerStrokeColorDefaultLightColor">#E0E0E0</Color>

    <!-- Status Colors (Light Palette) -->
    <Color x:Key="StatusValidForegroundLightColor">#1B5E20</Color>
    <Color x:Key="StatusValidBackgroundLightColor">#E8F5E9</Color>
    <Color x:Key="StatusValidBorderLightColor">#A5D6A7</Color>

    <Color x:Key="StatusExpiredForegroundLightColor">#993D00</Color>
    <Color x:Key="StatusExpiredBackgroundLightColor">#FFF3E0</Color>
    <Color x:Key="StatusExpiredBorderLightColor">#FFCC80</Color>

    <Color x:Key="StatusErrorForegroundLightColor">#B71C1C</Color>
    <Color x:Key="StatusErrorBackgroundLightColor">#FFEBEE</Color>
    <Color x:Key="StatusErrorBorderLightColor">#EF9A9A</Color>

    <Color x:Key="StatusUnknownForegroundLightColor">#37474F</Color>
    <Color x:Key="StatusUnknownBackgroundLightColor">#ECEFF1</Color>
    <Color x:Key="StatusUnknownBorderLightColor">#B0BEC5</Color>

    <Color x:Key="StatusRunningForegroundLightColor">#0D47A1</Color>
    <Color x:Key="StatusRunningBackgroundLightColor">#E3F2FD</Color>
    <Color x:Key="StatusRunningBorderLightColor">#90CAF9</Color>

    <!-- Active Dynamic Brushes (Default to Dark) -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource ApplicationBackgroundDarkColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundDarkColor}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource CardBackgroundDarkColor}" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource ControlFillColorDefaultDarkColor}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource ControlFillColorSecondaryDarkColor}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource ControlFillColorTertiaryDarkColor}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextFillColorPrimaryDarkColor}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextFillColorSecondaryDarkColor}" />
    <SolidColorBrush x:Key="DataGridRowAlternatingBrush" Color="{StaticResource DataGridRowAlternatingDarkColor}" />
    <SolidColorBrush x:Key="DataGridHeaderBorderBrush" Color="{StaticResource DataGridHeaderBorderDarkColor}" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource DividerStrokeColorDefaultDarkColor}" />

    <SolidColorBrush x:Key="StatusValidForegroundBrush" Color="{StaticResource StatusValidForegroundDarkColor}" />
    <SolidColorBrush x:Key="StatusValidBackgroundBrush" Color="{StaticResource StatusValidBackgroundDarkColor}" />
    <SolidColorBrush x:Key="StatusValidBorderBrush" Color="{StaticResource StatusValidBorderDarkColor}" />

    <SolidColorBrush x:Key="StatusExpiredForegroundBrush" Color="{StaticResource StatusExpiredForegroundDarkColor}" />
    <SolidColorBrush x:Key="StatusExpiredBackgroundBrush" Color="{StaticResource StatusExpiredBackgroundDarkColor}" />
    <SolidColorBrush x:Key="StatusExpiredBorderBrush" Color="{StaticResource StatusExpiredBorderDarkColor}" />

    <SolidColorBrush x:Key="StatusErrorForegroundBrush" Color="{StaticResource StatusErrorForegroundDarkColor}" />
    <SolidColorBrush x:Key="StatusErrorBackgroundBrush" Color="{StaticResource StatusErrorBackgroundDarkColor}" />
    <SolidColorBrush x:Key="StatusErrorBorderBrush" Color="{StaticResource StatusErrorBorderDarkColor}" />

    <SolidColorBrush x:Key="StatusUnknownForegroundBrush" Color="{StaticResource StatusUnknownForegroundDarkColor}" />
    <SolidColorBrush x:Key="StatusUnknownBackgroundBrush" Color="{StaticResource StatusUnknownBackgroundDarkColor}" />
    <SolidColorBrush x:Key="StatusUnknownBorderBrush" Color="{StaticResource StatusUnknownBorderDarkColor}" />

    <SolidColorBrush x:Key="StatusRunningForegroundBrush" Color="{StaticResource StatusRunningForegroundDarkColor}" />
    <SolidColorBrush x:Key="StatusRunningBackgroundBrush" Color="{StaticResource StatusRunningBackgroundDarkColor}" />
    <SolidColorBrush x:Key="StatusRunningBorderBrush" Color="{StaticResource StatusRunningBorderDarkColor}" />

    <!-- DataGrid Column Header High Legibility Style -->
    <Style x:Key="HighContrastColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource HighContrastColumnHeaderStyle}" />

    <!-- DataGrid Row Style: Force Dark Elevated Background & High Legibility Foreground -->
    <Style x:Key="HighContrastDataGridRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridRow" BasedOn="{StaticResource HighContrastDataGridRowStyle}" />

    <!-- DataGrid Cell Style: Ensure Text Color is Always Primary White on Dark -->
    <Style x:Key="HighContrastDataGridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell" BasedOn="{StaticResource HighContrastDataGridCellStyle}" />

</ResourceDictionary>
